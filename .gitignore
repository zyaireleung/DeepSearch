# ============================================================
# DeepSearch — Git 忽略规则
# 生成：2026-11-01（上传前调查定稿）
# 目的：备份、API key、运行时数据库/状态/日志 一律不上传
# ============================================================

# ---------- macOS 系统文件 ----------
.DS_Store

# ---------- Node 依赖 ----------
node_modules/

# ============================================================
# 🔴 敏感凭证 —— 含真实 API key，禁止上传
# ============================================================
# 控制台配置：含 mem0 userKey（sk-mem-…）+ OpenViking ovApiKey
console/console-config.json
# 配置备份同样含真实 key
console/console-config.json.bak*

# ============================================================
# 🔴 备份文件 —— 禁止上传
# ============================================================
*.bak
*.bak-*
.backups/

# ============================================================
# 🔴 运行时数据库 / 状态 —— 含索引后的会话与记忆数据，禁止上传
# ============================================================
# SQLite 检索库（261MB，含全量索引数据）+ WAL/SHM
console/.data/
# 根级 mem0 导入运行状态
.data/

# OV 导入运行状态（会话 ID / 批次进度 / 消息计数）
console/ov-state.json
console/ov-done.json
console/ov-done-parts.json
console/ov-progress.json

# 运行时配置状态（本地资产绝对路径 / 队列 / 运行态）
console/.dsh/

# ============================================================
# 🔴 日志 / 沙盒运行产物 —— 禁止上传
# ============================================================
*.log
.tdai-logs/
.sandbox-logs/
.sandbox-run/

# ============================================================
# 🔴 开发历史文档 —— 含本机备份路径引用，禁止上传（本地保留）
# ============================================================
CHANGELOG.md

# ============================================================
# 🟡 本地配置 / 运行产物目录 —— 含本机 IP 拓扑，不入库（模板见 config.example.yaml）
# ============================================================
# 资产管线真实配置：含本机模型/向量服务 IP（占位符见 config.example.yaml）
console/llm-wiki-asset/config.yaml
# 运行时代码真版（被 6600 服务加载）：含本机嵌入服务 IP；模板见 .example，真版本地保留不动
console/server.js
console/search-api.js
