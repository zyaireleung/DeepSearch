async function mem0SearchHttp(body, timeoutMs = 3000) {
  // 常驻服务不可达快速失败（connect refused 立即抛，不阻塞）
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), timeoutMs);
  try {
    const resp = await fetch(`${MEM0_SERVER}/search`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body), signal: ctrl.signal });
    // fixes F4: 统一先解析 body（避免 503 source 不可用退化为 fallback）
    const data = await resp.json().catch(() => null);
    if (resp.status === 503 && data && data.source) return data; // activating/recovering 由调用方区分
    if (!resp.ok) {
      // 保留 500 错误体（Error finding id 检测需要 error 字段）
      if (resp.status === 500 && data && typeof data.error === 'string') return data;
      return null;
    }
    return data && data.ok === true ? data : null;
  } catch {
    return null;
  } finally {
    clearTimeout(t);
  }
}
// ── fixes F5: 活动 8915 一次有界自恢复（Error finding id → 重启一次 → 重试）──

function listeningPids(port) {
  try {
    const r = spawnSync('lsof', ['-iTCP:' + port, '-sTCP:LISTEN', '-n', '-P'], { encoding: 'utf8' });
    const pids = [];
    for (const line of (r.stdout || '').split('\n').slice(1)) {
      const m = line.trim().match(/^\S+\s+(\d+)/);
      if (m) pids.push(Number(m[1]));
    }
    return pids;
  } catch { return []; }
}
function pidAlive(pid) { try { process.kill(pid, 0); return true; } catch { return false; } }
function cmdMatches(pid) {
  try {
    const r = spawnSync('ps', ['-p', String(pid), '-o', 'command='], { encoding: 'utf8' });
    // fixes: 沙盒经 bootstrap(run_search_server.py) 启服务，命令行不含 server.py；
    // 生产不设 MEM0_OWNER_CMD_MATCH=用原生匹配串，零影响
    const needle = process.env.MEM0_OWNER_CMD_MATCH || 'mem0-search-server.py';
    return (r.stdout || '').includes(needle);
  } catch { return false; }
}
async function mem0HealthOk(port) {
  try {
    const ctrl = new AbortController(); const t = setTimeout(() => ctrl.abort(), 3000);
    const resp = await fetch('http://127.0.0.1:' + port + '/health', { signal: ctrl.signal });
    clearTimeout(t);
    if (!resp.ok) return false;
    const d = await resp.json().catch(() => null);
    return !!(d && d.ok === true && d.queryReady === true);
  } catch { return false; }
}
function adoptMem0SearchServer(port) {
  // 认领：恰好一个 LISTEN PID + ps 匹配 + /health ok → 写 owner
  // fixes: MEM0_OWNER_TRUST_PORT=1（沙盒）时跳过 ps 校验（DSH 文件沙盒拦截 ps 读其他进程，
  // 沙盒端口所有者只可能是本测试拉起）；生产不设=保留 ps 校验
  const trustPort = process.env.MEM0_OWNER_TRUST_PORT === '1';
  const pids = listeningPids(port);
  if (pids.length !== 1) return { ok: false, reason: 'unmanaged-server' };
  const pid = pids[0];
  if (!trustPort && !cmdMatches(pid)) return { ok: false, reason: 'unmanaged-server' };
  let cmd = '';
  if (!trustPort) cmd = spawnSync('ps', ['-p', String(pid), '-o', 'command='], { encoding: 'utf8' }).stdout || '';
  const owner = { pid, port, mode: 'adopted', commandHash: trustPort ? 'sandbox-trust' : crypto.createHash('sha256').update(cmd).digest('hex') };
  writeOwner(owner);
  return { ok: true, owner };
}
async function refreshMem0Owner(port) {
  // F6: 快速路径复查唯一 listener + health 后才复用；否则重认领
  const owner = readOwner();
  const pids = listeningPids(port);
  if (owner && pidAlive(owner.pid) && cmdMatches(owner.pid)
      && pids.length === 1 && pids[0] === owner.pid && await mem0HealthOk(port)) {
    return { ok: true, owner };
  }
  return adoptMem0SearchServer(port);
}
function stopManagedMem0SearchServer(port) {
  const owner = readOwner();

  try {
    process.kill(owner.pid, 'SIGTERM');
    // 等至多 5 秒
    for (let i = 0; i < 50; i++) {
      if (!pidAlive(owner.pid)) return true;
      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 100);
    }
  } catch {}
  try { process.kill(owner.pid, 'SIGKILL'); for (let i = 0; i < 20; i++) { if (!pidAlive(owner.pid)) return true; Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 100); } } catch {}
  // fixes F10: 进程已退（zombie/竞态下 pidAlive 可能短暂为 true）但端口已释放 → 视为停止成功
  return !pidAlive(owner.pid) || listeningPids(port).length === 0;
}
async function spawnMem0SearchServerFromActive(port, logPath) {
  const py = process.env.MEM0_VENV_PY || process.env.MEM0_PY || path.join(MEM0_ROOT, 'venv', 'bin', 'python');
  const server = process.env.MEM0_SEARCH_SERVER_BOOTSTRAP || process.env.MEM0_SEARCH_SERVER_PY || MEM0_SEARCH_SERVER_PY;
  const env = { ...process.env, MEM0_SANDBOX_ROOT: MEM0_ROOT, MEM0_SANDBOX_CHROMA: path.join(MEM0_ROOT, 'chroma-data'),
                MEM0_PROBE_RECORDS: path.join(MEM0_ROOT, 'probe-records.jsonl') };
  const child = spawn(py, [server, '--port', String(port)], { env, stdio: 'ignore', detached: true });
  child.unref();
  // fixes: spawn error 必须处理（ENOENT 等否则未捕获崩溃 console）
  child.on('error', () => {});
  writeOwner({ pid: child.pid, port, mode: 'spawned', commandHash: '' });
  return child;
}
// ── fixes Task 4: 候选预检 + 激活（journal 文件级回滚）──
function activePath(n) { return path.join(MEM0_ROOT, n); }
function candidatePath(workDir, n) { return path.join(workDir, n); }

async function preflightCandidate(workDir) {
  // 起临时 search server 于预检端口；require health queryReady + validationQuery 检索 ≥1
  // fixes F11: partial-completed 候选放行（validationQuery 仅 completed 强制；partial 以 queryReady 探针为校验）
  const rj = candidateOutcome(workDir);
  if (!rj || !['completed', 'partial-completed'].includes(rj.outcome)) return { ok: false, reason: 'candidate-incomplete' };
  if (rj && rj.skippedEmpty) return { ok: false, reason: 'skipped-empty-no-activate' };
  if (rj.outcome === 'completed' && !rj.validationQuery) return { ok: false, reason: 'candidate-incomplete' };
  const pids = listeningPids(MEM0_PREFLIGHT_PORT);
  if (pids.length !== 0) return { ok: false, reason: 'preflight-port-busy' };
  const py = process.env.MEM0_VENV_PY || path.join(MEM0_ROOT, 'venv', 'bin', 'python');
  const env = { ...process.env, MEM0_SANDBOX_ROOT: workDir, MEM0_SANDBOX_CHROMA: path.join(workDir, 'chroma-data'),
    MEM0_PROBE_RECORDS: path.join(workDir, 'probe-records.jsonl') }; // fixes: 预检 queryReady 依赖候选 probe
  const serverEntry = process.env.MEM0_SEARCH_SERVER_BOOTSTRAP || MEM0_SEARCH_SERVER_PY; // 沙盒=run_search_server.py 先注册 fake provider；生产不设=原生 server
  const child = spawn(py, [serverEntry, '--port', String(MEM0_PREFLIGHT_PORT)], { env, stdio: 'ignore', detached: true });
  child.unref();
  // 等 health（≤8s）
  for (let i = 0; i < 80; i++) {
    await new Promise((r) => setTimeout(r, 100));
    const pids2 = listeningPids(MEM0_PREFLIGHT_PORT);
    if (pids2.length === 0) continue;
    const ok = await mem0HealthOk(MEM0_PREFLIGHT_PORT);
    if (ok) break;
  }
  const hOk = await mem0HealthOk(MEM0_PREFLIGHT_PORT);
  if (!hOk) { try { process.kill(child.pid, 'SIGKILL'); } catch {} return { ok: false, reason: 'candidate-preflight-health-failed' }; }
  // validationQuery 检索（仅 completed 强制；partial-completed 以 queryReady 探针为校验）
  if (rj.outcome === 'completed') {
    const ctrl = new AbortController(); const t = setTimeout(() => ctrl.abort(), 5000);
    let found = false;
    try {
      const resp = await fetch('http://127.0.0.1:' + MEM0_PREFLIGHT_PORT + '/search', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ query: rj.validationQuery, limit: 5 }), signal: ctrl.signal });
      const d = await resp.json().catch(() => null);
      found = !!(d && d.ok === true && Array.isArray(d.items) && d.items.length > 0);
    } catch { found = false; }
    clearTimeout(t);
    try { process.kill(child.pid, 'SIGKILL'); } catch {}
    // 等端口释放
    for (let i = 0; i < 20; i++) { if (listeningPids(MEM0_PREFLIGHT_PORT).length === 0) break; await new Promise((r) => setTimeout(r, 100)); }
    return found ? { ok: true } : { ok: false, reason: 'candidate-preflight-query-failed' };
  }
  // partial-completed：health/queryReady 已证明候选可检索
  try { process.kill(child.pid, 'SIGKILL'); } catch {}
  for (let i = 0; i < 20; i++) { if (listeningPids(MEM0_PREFLIGHT_PORT).length === 0) break; await new Promise((r) => setTimeout(r, 100)); }
  return { ok: true };
}


async function activateReadyImport(runId) {
  // 前置：预检通过 → journal → 停 8915 → rename → 起新 → committed
  const workDir = path.join(MEM0_IMPORTS_ROOT, runId, 'work');  const pre = await preflightCandidate(workDir);
  if (!pre.ok) return pre;
  const rj = candidateOutcome(workDir);
  const journal = { runId, movedOld: [], movedCandidate: [], newServerStarted: false, committed: false };
  writeActivation(journal);
  const port = Number(process.env.MEM0_SEARCH_PORT || 8915);
  // 停受管 8915。fixes F8：8915 已不在听（已死/被清）→ 视为已停止，直接进入 cutover；
  // 仅当端口有"未受管监听者"（他人进程占 8915）才拒绝，防误杀。
  const own = await refreshMem0Owner(port);
  if (own.ok) {
    if (!stopManagedMem0SearchServer(port)) { fs.rmSync(MEM0_ACTIVATION, { force: true }); return { ok: false, reason: 'activation-stop-failed' }; }
  } else {
    if (listeningPids(port).length !== 0) { fs.rmSync(MEM0_ACTIVATION, { force: true }); return { ok: false, reason: 'unmanaged-server' }; }
    console.error('[mem0-activate] 8915 已不在听，跳过停止（视为已停止，直接 cutover）');
  }
  // rename: active/<n> → active/<n>.prev；candidate/<n> → active/<n>（逐文件 journal 追加）
  const recoveryDir = path.join(workDir, 'recovery');
  const rollback = async () => {
    if (journal.newServerStarted) { try { process.kill(readOwner().pid, 'SIGKILL'); } catch {} }
    fs.mkdirSync(recoveryDir, { recursive: true });
    // 1) 候选文件从 active 移回 recovery（倒序）；目录整体 rename（非空目录也成功）
    for (const n of [...journal.movedCandidate].reverse()) {
      const src = path.join(MEM0_ROOT, n);
      const dst = path.join(recoveryDir, n);
      try {
        if (fs.existsSync(src)) { if (fs.existsSync(dst)) fs.renameSync(dst, dst + '.stale-' + Date.now()); fs.renameSync(src, dst); }
        for (const st of fs.readdirSync(recoveryDir)) { if (st.includes('.stale-')) try { fs.rmSync(path.join(recoveryDir, st), { recursive: true, force: true }); } catch {} }
      } catch (e) { console.error('[rollback] candidate %s FAIL: ' + String(e.message || e), n); }
    }
    // 2) .prev 移回 active（倒序）；目标残留先移开避免 ENOTEMPTY
    for (const n of [...journal.movedOld].reverse()) {
      const pv = path.join(MEM0_ROOT, n + '.prev');
      const dst = path.join(MEM0_ROOT, n);
      try {
        if (fs.existsSync(pv)) { if (fs.existsSync(dst)) fs.renameSync(dst, dst + '.reject-' + Date.now()); fs.renameSync(pv, dst); }
        for (const rg of fs.readdirSync(MEM0_ROOT)) { if (rg.includes('.reject-')) try { fs.rmSync(path.join(MEM0_ROOT, rg), { recursive: true, force: true }); } catch {} }
      } catch (e) { console.error('[rollback] old %s FAIL: ' + String(e.message || e), n); }
    }
  };
  try {
    for (const n of BUNDLE_FILES) {
      const src = activePath(n);
      if (fs.existsSync(src)) {
        const pv = src + '.prev';
        // fixes F9: 上次激活成功后从不清理 .prev（历史只靠手动），残留 .prev 令 rename 报 ENOTEMPTY
        // → 旧 .prev 先移开（.prev.stale-<ts>），成功后再统一清扫
        if (fs.existsSync(pv)) { try { fs.renameSync(pv, pv + '.stale-' + Date.now()); } catch {} }
        fs.renameSync(src, pv);
        journal.movedOld.push(n);
        writeActivation(journal);
      }
      const c = candidatePath(workDir, n);
      if (fs.existsSync(c)) {
        fs.renameSync(c, src);
        journal.movedCandidate.push(n);
        writeActivation(journal);
      }
    }
    // 起新 8915（active 路径）
    await spawnMem0SearchServerFromActive(port);
    journal.newServerStarted = true; writeActivation(journal);
    let hOk = false; for (let i = 0; i < 8; i++) { hOk = await mem0HealthOk(port); if (hOk) break; await new Promise((r) => setTimeout(r, 500)); }
    if (!hOk) { await rollback(); fs.rmSync(MEM0_ACTIVATION, { force: true }); releaseImportLock(); return { ok: false, reason: 'activation-health-failed' }; }
    journal.committed = true; writeActivation(journal);
    fs.rmSync(MEM0_ACTIVATION, { force: true });
    releaseImportLock();
    // fixes F11: 激活后 active lastOutcome 与 run.json outcome 对齐（候选 state 不写 lastOutcome，直接换入会残留旧值）
    try {
      const as = readMem0State();
      if (rj && rj.outcome && as.lastOutcome !== rj.outcome) { as.lastOutcome = rj.outcome; writeMem0State(as); }
    } catch {}
    // fixes F9: 清扫本轮回滚/切库产生的 .prev.stale-（成功路径留痕清理）
    try { for (const st of fs.readdirSync(MEM0_ROOT)) { if (st.includes('.prev.stale-')) fs.rmSync(path.join(MEM0_ROOT, st), { recursive: true, force: true }); } } catch {}
    return { ok: true };
  } catch (e) {
    await rollback();
    fs.rmSync(MEM0_ACTIVATION, { force: true });
    releaseImportLock();
    return { ok: false, reason: (e && e.message) || String(e) };
  }
}

async function recoverMem0SearchServerOnce(port) {
  if (mem0RecoveryPromise) return mem0RecoveryPromise;
  if (Date.now() - lastMem0RecoveryAt < MEM0_RECOVERY_COOLDOWN_MS) return false;
  lastMem0RecoveryAt = Date.now();
  mem0RecoveryPromise = (async () => {
    try {
      const r = await refreshMem0Owner(port);
      console.error('[dbg-recover-in] refresh=', JSON.stringify(r));
      if (!r.ok) return false;
      const st = stopManagedMem0SearchServer(port);
      console.error('[dbg-recover-in] stop=', st, 'listening-after=', JSON.stringify(listeningPids(port)));
      if (!st) return false;
      // 等端口释放（最多 5s）
      for (let i = 0; i < 50 && listeningPids(port).length !== 0; i++) await new Promise((q) => setTimeout(q, 100));
      if (listeningPids(port).length !== 0) return false;
      await spawnMem0SearchServerFromActive(port);
      // fixes: 新 server 冷启动需数秒，health 轮询最长 10s
      for (let i = 0; i < 20; i++) {
        const ok = await mem0HealthOk(port);
        if (ok) return true;
        await new Promise((q) => setTimeout(q, 500));
      }
      return false;
    } catch (e) { console.error('[dbg-recover-in] EXC=', String(e && e.message || e)); return false; }
    finally { mem0RecoveryPromise = null; }
  })();
  return mem0RecoveryPromise;
}

// mem0 检索结果内容级去重（2026-10-07 方案B）：同文本趋同抽取只保留一条。
// 归一化 key（去引号/括号内容/折叠空白）→ 处理弯直引号、有无注释括号等近似变体。
// 适用于 server 与 fallback 两条路径；保留分数最高/首个。
function normContent(c) {
  return String(c || '')
    .replace(/[“”"'«»]/g, '')
    .replace(/（[^）]*）/g, '')
    .replace(/\([^)]*\)/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}
function dedupMem0Items(items) {
  if (!Array.isArray(items)) return { items: items || [], deduped: 0 };
  const seen = new Set();
  const out = [];
  let deduped = 0;
  for (const it of items) {
    const c = String((it && it.content) || '');
    if (!c) { continue; }
    const key = normContent(c);
    if (seen.has(key)) { deduped += 1; continue; }
    seen.add(key);
    out.push(it);
  }
  return { items: out, deduped };
}
    if (req.method === 'POST' && p === '/api/mem0/activate') {
      // 候选预检+激活（仅 completed 候选；预检 8916 → 停 8915 → rename → spawn 新 8915）
      try {
        const body = await readBody(req);
        const runId = body.runId;
        if (!runId) return json(res, 400, { ok: false, reason: 'runId 必填' });
        if (readActivation()) return json(res, 409, { ok: false, reason: '已有激活进行中' });
        const r = await activateReadyImport(runId);
        return json(res, r.ok ? 200 : 500, r);
      } catch (e) { return json(res, 500, { ok: false, reason: (e && e.message) || String(e) }); }
    }
if (req.method === 'POST' && p === '/api/mem0/search') {
      try {
        // SC-02: 激活/切换进行中（activation journal 未清除）→ 统一 503 activating，杜绝 rename 窗口 fallback 直读 active
        if (readActivation()) return json(res, 503, { ...MEM0_ACTIVATING, reason: '激活切换中，请稍后重试' });
        const body = await readBody(req);
        const query = String(body.query || '').slice(0, 2048);
        if (!query) return json(res, 400, { ok: false, reason: 'query 必填' });
        const limit = Math.max(1, Math.min(20, Number(body.limit) || 5));
        // 1) 常驻服务优先（2026-10-05：响应带 source="server" 供插件识别常驻路径）
        const fromServer = await mem0SearchHttp({ query, limit });
        if (fromServer && fromServer.source === 'activating') return json(res, 503, MEM0_ACTIVATING);
        if (fromServer && fromServer.source === 'recovering') {
          const retryAfterMs = Math.min(Math.max(Number(fromServer.retryAfterMs) || MEM0_RECOVERY_MAX_MS, 500), MEM0_RECOVERY_MAX_MS);
          return json(res, 503, { ...MEM0_RECOVERING, retryAfterMs });
        }
        if (fromServer && fromServer.ok === true) {
          const d = dedupMem0Items(fromServer.items);
          return json(res, 200, { ...fromServer, items: d.items, deduped: d.deduped, source: 'server' });
        }
        const searchPort = Number(process.env.MEM0_SEARCH_PORT || 8915);
        // fixes F5: 若错误体含 Error finding id → 恢复一次并重试原查询
        if (fromServer && typeof fromServer.error === 'string' && fromServer.error.includes('Error finding id')) {
          console.error('[dbg-recover] Error finding id detected, source=', JSON.stringify(fromServer).slice(0,120));
          const ok = await recoverMem0SearchServerOnce(searchPort);
          console.error('[dbg-recover] recover result=', ok);
          if (ok) {
            // fixes: 恢复后新 server 冷启动（Memory 初始化+chroma 加载）需数秒，
            // 轮询重试最长 10s（对齐 MEM0_RECOVERY_MAX_MS 恢复预算）
            const deadline = Date.now() + MEM0_RECOVERY_MAX_MS;
            while (Date.now() < deadline) {
              const retry = await mem0SearchHttp({ query, limit });
              if (retry && retry.ok === true) {
                const d = dedupMem0Items(retry.items);
                return json(res, 200, { ...retry, items: d.items, deduped: d.deduped, source: 'server', recovered: true });
              }
              await new Promise((r) => setTimeout(r, 500));
            }
            return json(res, 503, { ok: false, source: 'recovering', retryAfterMs: 3000, reason: '恢复后重试仍失败' });
          }
        }
        // fixes F7（需求：导入期间 8915 不降级 fallback 慢路）：
        // 8915 在听但 /search 超时/失败（挂死、或未 queryReady 的 503 无 source）→
        // ①health 正常先给一次长预算重试（防"慢但健康"被误判）②仍失败→有界恢复一次+重试
        // ③恢复预算内成功→server；否则→503 recovering（快速失败，绝不走 60-90s 慢路）。
        // 仅当端口真不在听（8915 彻底消失）才走一次性脚本 fallback（插件据此懒拉起）。
        const hasListener = listeningPids(searchPort).length > 0;
        if (hasListener) {
          const hOk = await mem0HealthOk(searchPort);
          if (hOk) {
            const retryLong = await mem0SearchHttp({ query, limit }, 8000);
            if (retryLong && retryLong.ok === true) {
              const d = dedupMem0Items(retryLong.items);
              return json(res, 200, { ...retryLong, items: d.items, deduped: d.deduped, source: 'server' });
            }
          }
          const recovered = await recoverMem0SearchServerOnce(searchPort);
          if (recovered) {
            const deadline = Date.now() + MEM0_RECOVERY_MAX_MS;
            while (Date.now() < deadline) {
              const retry = await mem0SearchHttp({ query, limit });
              if (retry && retry.ok === true) {
                const d = dedupMem0Items(retry.items);
                return json(res, 200, { ...retry, items: d.items, deduped: d.deduped, source: 'server', recovered: true });
              }
              await new Promise((r) => setTimeout(r, 500));
            }
          }
          console.error('[mem0-search] 8915 在听但检索失败 → 503 recovering（不降级慢路）query=' + query.slice(0, 40));
          return json(res, 503, { ...MEM0_RECOVERING, reason: '8915 在听但检索失败，恢复未就绪（不降级慢路）' });
        }
        // 2) fallback：一次性脚本（source="fallback" → 插件据此触发懒拉起常驻服务）
        //    MEM0_SANDBOX_CHROMA 显式透传：沙盒测试指向重建段；生产缺省= root/chroma-data
        const spawnEnv = { ...process.env, MEM0_DIR: MEM0_PY_DIR, MEM0_SANDBOX_ROOT: MEM0_ROOT,
                          MEM0_SANDBOX_CHROMA: process.env.MEM0_SANDBOX_CHROMA || path.join(MEM0_ROOT, 'chroma-data') };
        ['http_proxy', 'https_proxy', 'HTTP_PROXY', 'HTTPS_PROXY', 'NO_PROXY', 'no_proxy'].forEach((k) => delete spawnEnv[k]);
        const r = spawnSync(mem0Py(), [MEM0_SEARCH_PY, '--query', query, '--limit', String(limit)], { encoding: 'utf8', timeout: 60000, env: spawnEnv });
        if (r.status !== 0) return json(res, 500, { ok: false, reason: String(r.stderr || '').slice(0, 300) || 'mem0 search failed' });
        const out = r.stdout || '';
        // 脚本 stdout 可能含 chroma/spaCy/PostHog 警告行 → 只取最后一行 JSON
        const last = out.trim().split('\n').pop() || '';
        let data;
        try { data = JSON.parse(last); } catch { return json(res, 500, { ok: false, reason: 'mem0 search 输出解析失败: ' + last.slice(0, 200) }); }
        const fd = dedupMem0Items(data.items);
        return json(res, 200, { ...data, items: fd.items, deduped: fd.deduped, source: 'fallback' });
      } catch (e) { return json(res, 500, { ok: false, reason: (e && e.message) || String(e) }); }
    }

    // ── Embedding 预设（镜像 model.presets 增删改，存 config.model.embeddingPresets）──
    if (req.method === 'GET' && p === '/api/embedding-presets') {
      return json(res, 200, { ok: true, presets: Array.isArray(config.model?.embeddingPresets) ? config.model.embeddingPresets : [] });
    }
    if (req.method === 'POST' && p === '/api/embedding-presets') {
      const body = await readBody(req);
      const presets = saveEmbeddingPresets(body.presets);
      return json(res, 200, { ok: true, presets });
    }

    // ── Wiki 摄入模型预设（2026-10-20 起并入统一 LLM 总表 model.presets，此端点读写同一总表，前端无需改动）──
    if (req.method === 'GET' && p === '/api/wiki-model-presets') {
      return json(res, 200, { ok: true, presets: readModelPresets() });
    }
    if (req.method === 'POST' && p === '/api/wiki-model-presets') {
      const body = await readBody(req);
      const before = readModelPresets().length;
      const presets = saveModelPresets(body.presets);
      // 留痕（对齐原 wiki 摄入预设写操作日志）
      if (before === 0 && presets.length > 0) log('ok', `统一预设总表已保存 ${presets.length} 条（${presets.map((x) => x.name).join('、')}）`);
      else if (before > 0 && presets.length === 0) log('info', '统一预设总表已清空');
      else log('info', `统一预设总表已更新（${before} → ${presets.length} 条）`);
      return json(res, 200, { ok: true, presets });
    }

    // ── 阶段1：wiki/codegraph 资产列表（panel team-assets 只读 + 本地 managed 合并）──
    if (req.method === 'GET' && p === '/api/wiki-assets') return json(res, 200, await listAssets('wiki'));
    if (req.method === 'GET' && p === '/api/codegraph-assets') return json(res, 200, await listAssets('codegraph'));

    // ── LLM WIKI 板块（独立命名空间 /api/wiki/*，斜杠；与 /api/wiki-assets 连字符端点互不干扰）──
    if (req.method === 'GET' && p === '/api/wiki/assets') {
      const items = wikiAssets.listAssetsW().map(a => ({ ...a, isAsset: isAssetSkeleton(a.path) }));
      return json(res, 200, { ok: true, items, total: items.length });
    }
    if (req.method === 'POST' && p === '/api/wiki/assets') {
      const body = await readBody(req);
      const target = String(body.path || '').trim();
      if (!target) return json(res, 400, { ok: false, reason: 'path 必填' });
      // 拒绝注册内嵌模版自身或子路径（assetize.py 同样拒绝 target==SELF / SELF in parents）
      const self = path.resolve(ASSET_SELF);
      if (target === self || target.startsWith(self + path.sep))
        return json(res, 400, { ok: false, reason: '不能注册内嵌资产模版自身' });
      if (!fs.existsSync(target)) return json(res, 400, { ok: false, reason: '目录不存在' });
      if (!fs.statSync(target).isDirectory()) return json(res, 400, { ok: false, reason: '不是目录' });
      // 同 path 幂等：已注册 → 返回既有资产，不重复资产化
      const existing = wikiAssets.listAssetsW().find(a => path.resolve(a.path) === path.resolve(target));
      if (existing) return json(res, 200, { ok: true, asset: existing, created: false, duplicate: true });
      // 2026-10-30：新建资产必须带 code（工具参数标识），空则不创建 —— 前端弹窗已保证，后端兜底校验
      if (typeof body.code !== 'string' || !body.code.trim())
        return json(res, 400, { ok: false, reason: 'code 必填（新增资产不能为空 code）' });
      const id = 'wiki-' + Date.now().toString(36);
      const regOpts = { id, name: path.basename(target), path: target, code: body.code, description: body.description };
      if (!isAssetSkeleton(target)) {
        // 确认后立即登记 pending，让导入/配置两页同步呈现“新建中”；实际目录移动仍只在队首执行。
        if (body.confirm !== true) return json(res, 400, { ok: false, reason: '目录非资产，资产化会将其内容移入 raw/，需 confirm:true' });
        const pending = wikiAssets.registerPendingAsset(regOpts);
        if (!pending.ok) return json(res, 422, pending);
        const q = wikiQueue.enqueue({ type: 'assetize', id, path: target, assetizeSelf: ASSET_SELF });
        if (!q.ok) { wikiAssets.unregisterAsset(id); return json(res, 409, q); }
        return json(res, 202, { ok: true, queued: true, created: true, asset: pending.asset, position: q.position });
      }
      const reg = wikiAssets.registerAsset(regOpts);
      if (!reg.ok) return json(res, 422, reg);
      return json(res, 200, { ok: true, asset: reg.asset, created: false });
    }
    if (req.method === 'POST' && p === '/api/wiki/assets/toggle') {
      const body = await readBody(req);
      const r = wikiAssets.setAssetEnabled(body.id || '', !!body.enabled);   // 写回注册表 JSON
      return r.ok ? json(res, 200, r) : json(res, 409, r);
    }
    if (req.method === 'POST' && p === '/api/wiki/assets/description') {
      const body = await readBody(req);
      // 新模型 { code, description }；旧模型 { contains, excludes } 由 updateAssetDescription 迁移。
      const r = wikiAssets.updateAssetDescription(String(body.id || ''), body);
      return json(res, r.ok ? 200 : (r.reason === 'not found' ? 404 : 422), r);
    }
    if (req.method === 'POST' && p === '/api/wiki/assets/cancel') {
      const body = await readBody(req);
      const a = wikiAssets.getAsset(body.id || '');
      if (!a) return json(res, 404, { ok: false, reason: 'asset 未注册' });
      if (a.state !== 'pending-assetize') return json(res, 409, { ok: false, reason: '仅等待中的新建任务可取消' });
      const q = wikiQueue.cancelPendingAssetize(a.id);
      if (!q.ok) return json(res, 409, q);
      wikiAssets.unregisterAsset(a.id);
      return json(res, 200, { ok: true });
    }
    if (req.method === 'DELETE' && p === '/api/wiki/assets') {
      const body = await readBody(req);
      const a = wikiAssets.getAsset(body.id || '');
      // ready 与资产化/首次解析失败态均可注销（失败资产必须能清理）；等待中请用取消；进行中/解析中拒绝
      const deletableFail = a?.state === 'assetize-failed' || a?.state === 'first-update-failed';
      if (a?.state && a.state !== 'ready' && !deletableFail)
        return json(res, 409, { ok: false, reason: a.state === 'pending-assetize' ? '等待中的新建任务请点击「取消」' : '资产化/首次解析进行中，暂不能删除' });
      const r = wikiAssets.unregisterAsset(body.id);
      // 2026-10-22：删资产后清其残留运行状态（run-state.lastError 残留会导致
      // 前端持续显示「上次更新失败」提示条，即使资产已删）
      if (r.ok) wikiRunner.clearAssetStaleState(body.id);
      return r.ok ? json(res, 200, r) : json(res, 404, r);
    }
    // 系统文件夹选择器（macOS 原生弹窗）——新增Wiki 用系统弹窗选目录，不用自制输入框
    if (req.method === 'POST' && p === '/api/wiki/pick-folder') {
      pickFolder();
      return json(res, 200, { ok: true, pending: true });
    }
    if (req.method === 'GET' && p === '/api/wiki/pick-folder/result') {
      return json(res, 200, { ok: true, done: !!(wikiPick && wikiPick.done), path: wikiPick ? wikiPick.path : null });
    }

    // ── LLM WIKI 资产配置读写（config.yaml：备份 → 校验 → 原子写盘）──
    if (req.method === 'GET' && p === '/api/wiki/config') {
      const a = wikiAssets.getAsset(String(new URL(req.url, 'http://x').searchParams.get('asset') || ''));
      if (!a) return json(res, 404, { ok: false, reason: 'asset 未注册' });
      if (a.state && a.state !== 'ready') return json(res, 409, { ok: false, reason: '资产新建中，完成后才可配置' });
      const cfg = path.join(a.path, 'config.yaml');
      if (!fs.existsSync(cfg)) return json(res, 404, { ok: false, reason: 'config.yaml 缺失' });
      const yaml = fs.readFileSync(cfg, 'utf8');
      const r = spawnSync('python3', ['-c', 'import yaml,sys,json;print(json.dumps(yaml.safe_load(open(sys.argv[1]))))', cfg], { encoding: 'utf8' });
      return json(res, 200, { ok: true, path: cfg, yaml, parsed: r.status === 0 ? JSON.parse(r.stdout) : null });
    }
    if (req.method === 'POST' && p === '/api/wiki/config') {
      const body = await readBody(req);
      const a = wikiAssets.getAsset(body.asset || '');
      if (!a) return json(res, 404, { ok: false, reason: 'asset 未注册' });
      const cfg = path.join(a.path, 'config.yaml');
      if (!fs.existsSync(cfg)) return json(res, 404, { ok: false, reason: 'config.yaml 缺失' });
      // 时序：先写 tmp → 校验通过 → 才备份原文件 → 原子 rename。
      // 校验失败不产生 .bak-*、不碰原文件（备份只在真正写入前一刻生成）。
      // 2026-10-20：stage model 可解析自「资产内 model_templates ∪ 统一预设总表」；
      // 总表有而文件缺的模板 → 自动补入快照（应用新预设 → config.yaml 快照添加）。
      const tmp = cfg + '.tmp';
      fs.writeFileSync(tmp, String(body.content || ''));
      const v = spawnSync('python3', ['-c', `import yaml,sys,json
d=yaml.safe_load(open(sys.argv[1])) or {}
m=d.setdefault('model_templates',{})
master=json.loads(sys.stdin.read())
stages=d.get('stages',{}) or {}
mnames=set(m.keys()); mnames_master={p['name']:p for p in master if p and p.get('name')}
need=[s['model'] for k,s in stages.items() if s and s.get('model') and s['model'] not in m and s['model'] not in mnames_master]
assert not need, 'stage model 不在 model_templates 也不在统一预设总表: '+','.join(str(x) for x in need)
added=[]
for k,s in stages.items():
    if not s or not s.get('model'): continue
    nm=s['model']
    if nm in m or nm not in mnames_master: continue
    mp=mnames_master[nm]
    t={'name':mp.get('model') or nm,'base_url':mp.get('baseUrl') or '','api_key':mp.get('apiKey') or ''}
    for f in ('temperature','enable_thinking','no_proxy','timeout','max_tokens'):
        if mp.get(f) is not None: t[f]=mp[f]
    m[nm]=t; added.append(nm)
if added: open(sys.argv[1],'w').write(yaml.safe_dump(d,allow_unicode=True,sort_keys=False))
print(json.dumps({'added':added}))`, tmp], { input: JSON.stringify(readModelPresets()), encoding: 'utf8' });
      if (v.status !== 0) { fs.rmSync(tmp, { force: true }); return json(res, 422, { ok: false, reason: v.stderr.trim().slice(0, 300) }); }
      let snapshotAdded = [];
      try { snapshotAdded = JSON.parse((v.stdout || '{}').trim()).added || []; } catch {}
      const bak = cfg + '.bak-' + new Date().toISOString().replace(/[:.]/g, '-');
      fs.copyFileSync(cfg, bak);
      fs.renameSync(tmp, cfg);
      if (snapshotAdded.length) log('info', `资产 ${a.name || a.id} 快照补模板（自统一总表）：${snapshotAdded.join('、')}`);
      return json(res, 200, { ok: true, backup: bak, snapshotAdded });
    }

    // ── 沙盒测试钩子（仅 LLM_PRESETS_TEST_HOOK=1 时挂载；生产不设置该 env → 路由不存在）──
    // 用途：模拟「8126 统一总表不可读」时刻（总表故障 → 资产快照离线兜底）。
    if (process.env.LLM_PRESETS_TEST_HOOK === '1' && req.method === 'POST' && p === '/api/sandbox/master-outage') {
      const b = await readBody(req);
      llmPresets.setMasterAvailable(!b.enabled);
      log('info', `[sandbox-hook] 统一预设总表可用性 → ${!b.enabled ? '可用' : '故障注入'}`);
      return json(res, 200, { ok: true, masterAvailable: !b.enabled });
    }

    // ── LLM WIKI 更新控制（所有更新统一进持久化单队列）──
    if (req.method === 'GET' && p === '/api/wiki/queue') {
      return json(res, 200, { ok: true, ...wikiQueue.getQueueStatus() });
    }
    if (req.method === 'POST' && p === '/api/wiki/update') {
      const body = await readBody(req);
      const asset = wikiAssets.getAsset(body.asset || '');
      if (!asset) return json(res, 404, { ok: false, reason: 'asset 未注册' });
      if (asset.state && asset.state !== 'ready') return json(res, 409, { ok: false, reason: '资产新建中，完成后才可更新' });
      const r = wikiQueue.enqueue({ type: 'update', id: asset.id });
      return r.ok ? json(res, 202, r) : json(res, 409, r);
    }
    if (req.method === 'POST' && p === '/api/wiki/update/pause') {
      const r = wikiRunner.pauseUpdate();
      return r.ok ? json(res, 200, r) : json(res, 400, r);
    }
    if (req.method === 'POST' && p === '/api/wiki/update/resume') {
      const r = wikiRunner.resumeUpdate();
      return r.ok ? json(res, 200, r) : json(res, 400, r);
    }
    if (req.method === 'POST' && p === '/api/wiki/update/stop') {
      const r = wikiRunner.stopUpdate();
      return r.ok ? json(res, 200, r) : json(res, 400, r);
    }
    if (req.method === 'GET' && p === '/api/wiki/update/progress') {
      const assetId = new URL(req.url, 'http://x').searchParams.get('asset') || '';
      return json(res, 200, wikiRunner.getProgress({ id: assetId }));
    }
    // LLM WIKI 定时配置（wikiUpdate 子键；读写 + 重挂定时）
    if (req.method === 'GET' && p === '/api/wiki/update/config') {
      return json(res, 200, { ok: true, config: { ...DEFAULT_CONFIG.wikiUpdate, ...(config.wikiUpdate || {}) }, nextRunAt: wikiNextRunAt });
    }
    if (req.method === 'POST' && p === '/api/wiki/update/config') {
      const body = await readBody(req);
      config.wikiUpdate = { ...DEFAULT_CONFIG.wikiUpdate, ...(config.wikiUpdate || {}), ...(body.config || {}) };
      saveConfig(config);
      applyWikiScheduler();
      return json(res, 200, { ok: true, config: config.wikiUpdate, nextRunAt: wikiNextRunAt });
    }

    // ── 阶段1：wiki 标签映射（pages/label/toggle/validate）──
    if (req.method === 'GET' && p === '/api/wiki-map/pages') {
      const wikiId = new URL(req.url, 'http://x').searchParams.get('wiki_id');
      if (!wikiId) return json(res, 400, { ok: false, reason: 'wiki_id required' });
      return json(res, 200, await wikiMapPages(wikiId));
    }
    if (req.method === 'POST' && p === '/api/wiki-map/label') {
      const b = await readBody(req);
      if (b.action === 'add') maps.addLabelRef('wiki', b.label, { wikiId: b.wiki_id, id: b.id, titleAtSave: b.title });
      else maps.removeLabelRef('wiki', b.label, b.wiki_id, b.id);
      return json(res, 200, { ok: true });
    }
    if (req.method === 'POST' && p === '/api/wiki-map/toggle') {
      const b = await readBody(req);
      maps.toggleManaged('wiki', b.wiki_id, !!b.on, b.name); // r4：携带资产名（wiki 无项目名标签语义，name 仅资产显示用）
      log('ok', `Wiki 资产已${b.on ? '纳入管理' : '取消管理'}：${(b.name || b.wiki_id)}（${b.wiki_id}）`);
      return json(res, 200, { ok: true });
    }
    if (req.method === 'POST' && p === '/api/wiki-map/toggle-label') {
      // t9d-r3：标签启用/停用（静音命中）持久化
      const b = await readBody(req);
      maps.toggleMuted('wiki', b.label, !!b.on);
      log('ok', `Wiki 标签已${b.on ? '停用' : '启用'}：${b.label}（${b.on ? '不唤醒注入' : '恢复唤醒'}）`);
      return json(res, 200, { ok: true });
    }
    if (req.method === 'POST' && p === '/api/wiki-map/validate') {
      const b = await readBody(req);
      return json(res, 200, await wikiMapValidate(b.wiki_id));
    }
    if (req.method === 'POST' && p === '/api/wiki-map/fix') {
      const b = await readBody(req);
      if (!b.wiki_id) return json(res, 400, { ok: false, reason: 'wiki_id required' });
      const r = await wikiMapFix(b.wiki_id);
      if (r.ok) log('ok', `Wiki 映射一键修复：${r.fixed} 处漂移重挂${r.skipped ? `，${r.skipped} 处失效跳过` : ''}`);
      return json(res, 200, r);
    }
    if (req.method === 'POST' && p === '/api/wiki-map/rename') {
      const b = await readBody(req);
      const before = (maps.loadMaps('wiki').labels[b.old] || []).length;
      const merged = !!maps.loadMaps('wiki').labels[b.next] && b.old !== b.next;
      maps.renameLabel('wiki', b.old, b.next);
      return json(res, 200, { ok: true, moved: before, merged });
    }
    if (req.method === 'POST' && p === '/api/wiki-map/drop-source') {
      const b = await readBody(req);
      const d0 = maps.loadMaps('wiki');
      let removed = 0;
      for (const lb of Object.keys(d0.labels)) removed += d0.labels[lb].filter((r) => r.wiki_id === b.wiki_id && r.id === b.id).length;
      maps.dropSource('wiki', b.wiki_id, b.id);
      return json(res, 200, { ok: true, removed });
    }
    if (req.method === 'POST' && p === '/api/wiki-map/seed') {
      const b = await readBody(req);
      try {
        const live = await ksPost('/v3/wiki/page/ls', { wiki_id: b.wiki_id });
        const cfg = readKsEnv();
        const r = await seedLabels(cfg, live, { dryRun: b.dryRun !== false, maxPages: Number(b.maxPages || 3), kind: 'wiki', wikiId: b.wiki_id });
        if (!b.dryRun && r.ok) log('ok', `Wiki 资产「${(maps.loadMaps('wiki').assets[b.wiki_id]?.name || b.wiki_id)}」已使用「从页面标题生成初始标签」批量创建标签 ${r.generated.length} 个`);
        return json(res, 200, r);
      } catch (e) {
        return json(res, 200, { ok: false, reason: String((e && e.message) || e) });
      }
    }

    // ── t9d-r3：全量混合标签（wiki+cg，含 muted 状态与 kind 标注；datalist 真源）──
    if (req.method === 'GET' && p === '/api/kb/labels') {
      try {
        const wikiMap = maps.loadMaps('wiki');
        const cgMap = maps.loadMaps('codegraph');
        const wmuted = new Set(wikiMap.mutedLabels || []);
        const cmuted = new Set(cgMap.mutedLabels || []);
        const labels = [];
        // r4：CG 资产名 = 项目名默认隐藏标签，排除（wiki 无项目名标签语义）
        const cgProjectNames = new Set(Object.values(cgMap.assets || {}).map((a) => a && a.name).filter(Boolean));
        for (const lb of Object.keys(wikiMap.labels || {})) labels.push({ label: lb, kind: 'wiki', muted: wmuted.has(lb) });
        for (const lb of Object.keys(cgMap.labels || {})) {
          if (cgProjectNames.has(lb)) continue; // 项目名标签默认隐藏，不进列表
          labels.push({ label: lb, kind: 'cg', muted: cmuted.has(lb) });
        }
        return json(res, 200, { ok: true, labels });
      } catch (e) {
        return json(res, 200, { ok: false, reason: String((e && e.message) || e) });
      }
    }

    // ── t9d-r2+r4：知识库中转聚合查询（多目的地场景 agent 入口；每资产附 map 扩展字段）
    // 方案B（2026-09-21 用户拍板）：mapped=标签映射页列表（主，精确）+ spread=FTS 内容扩散（辅）
    if (req.method === 'POST' && p === '/api/kb/search') {
      try {
        const body = await readBody(req);
        const query = String(body.query || '').trim();
        if (!query) return json(res, 400, { ok: false, reason: 'query required' });
        const hop = Number(body.hop ?? 2);
        const limit = Number(body.limit ?? 5);
        const results = [];
        const errors = [];
        const wikiMap = maps.loadMaps('wiki');
        const cgMap = maps.loadMaps('codegraph');

        // ── ① mapped：命中标签 → maps.labels 映射页列表（跨资产，精确主通道）──
        // t9d-r4（2026-09-22 用户拍板）：mapped 只显示【精准匹配】标签的映射页——
        //   label 必须在 query 中作为完整词出现（前后词边界），子串兄弟标签（如 dsh-agent-teams 标准规划审核表）
        //   不误入；按 (wiki_id, 页面 id) 去重（同页多标签映射算 1，防重复计数漏网）。
        const mappedRefs = [];
        const escRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const labelHit = (label) => new RegExp(`(^|\\s)${escRe(label)}(\\s|$)`).test(' ' + query + ' ');
        const seenMapped = new Set();
        const pushMapped = (kind, label, r, name) => {
          const key = `${kind}:${r.wiki_id}::${r.id}`;
          if (seenMapped.has(key)) return; // 去重：同资产同页多标签只列一次
          seenMapped.add(key);
          // 2026-09-22：mapped 条目不带 label 字段——页面就是页面，标签只用于唤醒定位/字段搜索，不标注关联
          mappedRefs.push({ kind, wiki_id: r.wiki_id, name, id: r.id, titleAtSave: r.titleAtSave || r.id });
        };
        for (const [label, refs] of Object.entries(wikiMap.labels || {})) {
          if (labelHit(label)) {
            for (const r of refs) {
              const asset = wikiMap.assets && wikiMap.assets[r.wiki_id];
              if (!asset || !asset.managed) continue; // 未纳管资产映射不展示
              pushMapped('wiki', label, r, (asset.name || r.wiki_id));
            }
          }
        }
        for (const [label, refs] of Object.entries(cgMap.labels || {})) {
          if (labelHit(label)) {
            for (const r of refs) {
              const asset = cgMap.assets && cgMap.assets[r.wiki_id];
              if (!asset || !asset.managed) continue;
              pushMapped('cg', label, r, (asset.name || r.wiki_id));
            }
          }
        }
        const mapped = [...mappedRefs].sort((a, b) => a.wiki_id.localeCompare(b.wiki_id) || a.id.localeCompare(b.id));

        // ── ② spread：对 managed 资产 FTS 内容扩散（辅通道，覆盖无标签但内容含词页）──
        // wiki：遍历 managed 资产
        const wikiIds = Object.keys(wikiMap.assets || {}).filter((id) => wikiMap.assets[id] && wikiMap.assets[id].managed);
        for (const wikiId of wikiIds) {
          try {
            const r = await fetch(`${KS_URL}/v3/wiki/search`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'x-tdai-service-id': 'default' },
              body: JSON.stringify({ wiki_id: wikiId, query, hop, limit }),
            });
            if (!r.ok) throw new Error(`KS wiki/search HTTP ${r.status}`);
            const j = await r.json();
            const hits = ((j.data && j.data.results) || []).map((x) => ({
              id: String(x.path || '').replace(/^wiki\//, '').replace(/\.md$/, ''), // page/read 的 refs 用页面 id（去 wiki/ 前缀和 .md）
              path: x.path, title: x.title, snippet: x.snippet, score: x.score, type: x.type, hop: x.hop,
            }));
            if (hits.length) {
              results.push({
                kind: 'wiki', id: wikiId, name: wikiMap.assets[wikiId].name || wikiId,
                hits,
                map: '扩展（host 与 header 固定：curl 的 -H "x-tdai-service-id: default" 必须保留）：\n  1) 查全库关系：curl -X POST "' + KS_URL + '/v3/wiki/graph" -H "x-tdai-service-id: default" -d \'{"wiki_id":"' + wikiId + '"}\'\n  2) 读命中页全文：curl -X POST "' + KS_URL + '/v3/wiki/page/read" -H "x-tdai-service-id: default" -d \'{"wiki_id":"' + wikiId + '","refs":["<用 hits/mapped 里某条的 id 字段>"]}\'',
              });
            }
          } catch (e) { errors.push({ kind: 'wiki', id: wikiId, reason: String((e && e.message) || e) }); }
        }
        // cg：遍历 managed 资产（索引 DB 存在才查询，项目不在不注入）
        const cgIds = Object.keys(cgMap.assets || {}).filter((id) => cgMap.assets[id] && cgMap.assets[id].managed);
        for (const cgId of cgIds) {
          try {
            const r = await fetch(`${KS_URL}/v3/code-graph/search`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'x-tdai-service-id': 'default' },
              body: JSON.stringify({ code_graph_id: cgId, query, limit }),
            });
            if (!r.ok) throw new Error(`KS cg/search HTTP ${r.status}`);
            const j = await r.json();
            const text = (j.data && j.data.text) || '';
            // cg search 返回文本（符号位置），解析节点行
            const hits = text.split('\n').filter((l) => l.trim() && !l.includes('No results')).slice(0, limit).map((l) => ({ text: l.trim().slice(0, 160) }));
            if (hits.length) {
              results.push({
                kind: 'cg', id: cgId, name: cgMap.assets[cgId].name || cgId,
                hits,
                map: '扩展（host 与 header 固定，-H "x-tdai-service-id: default" 必须保留；symbol 用命中符号名）：\n  1) callers 查谁调用：curl -X POST "' + KS_URL + '/v3/code-graph/callers" -H "x-tdai-service-id: default" -d \'{"code_graph_id":"' + cgId + '","symbol":"<符号>"}\'\n  2) callees/impact/node 同 host 换 action 即可',
              });
            }
          } catch (e) { errors.push({ kind: 'cg', id: cgId, reason: String((e && e.message) || e) }); }
        }
        return json(res, 200, { ok: true, query, mapped, results, errors });
      } catch (e) {
        return json(res, 200, { ok: false, reason: String((e && e.message) || e) });
      }
    }

    // ── 阶段1：codegraph 标签映射（与 wiki 同构）──
    if (req.method === 'GET' && p === '/api/codegraph-map/pages') {
      const cgId = new URL(req.url, 'http://x').searchParams.get('code_graph_id');
      if (!cgId) return json(res, 400, { ok: false, reason: 'code_graph_id required' });
      const local = maps.loadMaps('codegraph');
      const labelOf = {}; // nodeId -> [labels]
      for (const [lb, refs] of Object.entries(local.labels)) {
        for (const r of refs) {
          if (r.wiki_id !== cgId) continue;
          (labelOf[r.id] = labelOf[r.id] || []).push(lb);
        }
      }
      // t9b CG-NODES：从 codegraph 真实索引读节点（不再是"仅已登记标签"），合并标签标注
      const nodes = [];
      const issues = [];
      const indexDb = await findCgIndexDb(cgId);
      if (indexDb) {
        try {
          const rows = await queryCgNodes(indexDb);
          for (const n of rows) {
            nodes.push({ id: n.id, name: n.name, kind: n.kind, file: n.file_path, labels: labelOf[n.id] || [], ref: 'ok' });
          }
        } catch (e) { issues.push({ ref: 'index-error', problem: String((e && e.message) || e) }); }
      } else {
        issues.push({ ref: 'no-index', problem: 'codegraph 索引 DB 未找到（本地导入或索引未完成）' });
      }
      // 已登记标签但索引缺失的节点（drift/gone 场景）
      for (const [nodeId, lbs] of Object.entries(labelOf)) {
        if (!nodes.some((n) => n.id === nodeId)) nodes.push({ id: nodeId, name: nodeId.split(':').pop(), kind: nodeId.split(':')[0] || 'node', labels: lbs, ref: 'gone' });
      }
      return json(res, 200, { ok: true, code_graph_id: cgId, nodes, total: nodes.length, issues });
    }
    if (req.method === 'POST' && p === '/api/codegraph-map/label') {
      const b = await readBody(req);
      if (b.action === 'add') maps.addLabelRef('codegraph', b.label, { wikiId: b.wiki_id, id: b.id, titleAtSave: b.title });
      else maps.removeLabelRef('codegraph', b.label, b.wiki_id, b.id);
      return json(res, 200, { ok: true });
    }
    if (req.method === 'POST' && p === '/api/codegraph-map/toggle') {
      const b = await readBody(req);
      maps.toggleManaged('codegraph', b.wiki_id, !!b.on, b.name); // r4：CG 资产名 → 项目名默认隐藏标签来源
      log('ok', `CodeGraph 项目已${b.on ? '纳入管理' : '取消管理'}：${(b.name || b.wiki_id)}（${b.wiki_id}）`);
      return json(res, 200, { ok: true });
    }
    if (req.method === 'POST' && p === '/api/codegraph-map/toggle-label') {
      // t9d-r3：cg 标签启用/停用（静音命中）持久化
      const b = await readBody(req);
      maps.toggleMuted('codegraph', b.label, !!b.on);
      log('ok', `CodeGraph 标签已${b.on ? '停用' : '启用'}：${b.label}（${b.on ? '不唤醒注入' : '恢复唤醒'}）`);
      return json(res, 200, { ok: true });
    }
    if (req.method === 'POST' && p === '/api/codegraph-map/rename') {
      const b = await readBody(req);
      const before = (maps.loadMaps('codegraph').labels[b.old] || []).length;
      const merged = !!maps.loadMaps('codegraph').labels[b.next] && b.old !== b.next;
      maps.renameLabel('codegraph', b.old, b.next);
      return json(res, 200, { ok: true, moved: before, merged });
    }
    if (req.method === 'POST' && p === '/api/codegraph-map/drop-source') {
      const b = await readBody(req);
      const d0 = maps.loadMaps('codegraph');
      let removed = 0;
      for (const lb of Object.keys(d0.labels)) removed += d0.labels[lb].filter((r) => r.wiki_id === b.wiki_id && r.id === b.id).length;
      maps.dropSource('codegraph', b.wiki_id, b.id);
      return json(res, 200, { ok: true, removed });
    }
    if (req.method === 'POST' && p === '/api/codegraph-map/seed') {
      // t9c：CodeGraph 高频符号 → LLM 粗标种子（与 wiki seed 同构），dryRun=false 落盘 codegraph-map.json
      const b = await readBody(req);
      const cgId = b.code_graph_id;
      if (!cgId) return json(res, 400, { ok: false, reason: 'code_graph_id required' });
      try {
        const indexDb = await findCgIndexDb(cgId);
        if (!indexDb) return json(res, 200, { ok: false, reason: 'codegraph 索引 DB 未找到（先导入）' });
        const nodes = await queryCgNodes(indexDb);
        const cfg = readKsEnv();
        const r = await seedCgLabels(cfg, nodes, { dryRun: b.dryRun !== false, maxNodes: Number(b.maxNodes || 20), cgId });
        if (!b.dryRun && r.ok) log('ok', `CodeGraph 项目「${(maps.loadMaps('codegraph').assets[cgId]?.name || cgId)}」已使用「从高频符号生成初始标签」批量创建标签 ${r.generated.length} 个`);
        return json(res, 200, r);
      } catch (e) {
        return json(res, 200, { ok: false, reason: String((e && e.message) || e) });
      }
    }
    if (req.method === 'POST' && p === '/api/codegraph/import') {
      const b = await readBody(req);
      try {
        if (b.localPath) {
          // 本地直索引：写 KS DB。沙盒 run 覆盖 ksDbPath/ksDataRoot/panelUrl/serviceUrl 指向沙盒实体（生产零接触）
          const sandboxRoot = process.env.SANDBOX_KS_DATA_ROOT;
          const cfg = { ...CG_DEFAULT, teamId: config.import.teamId, ownerUserId: config.import.userId || config.import.userKey, userId: config.import.userId, agentId: config.import.agentId, panelUrl: process.env.SANDBOX_PANEL_URL || 'http://127.0.0.1:8123', panelUserKey: process.env.SANDBOX_PANEL_KEY || panelUserKey(), serviceUrl: process.env.SANDBOX_KS_URL || 'http://127.0.0.1:8421' };
          if (sandboxRoot) { cfg.ksDbPath = path.join(sandboxRoot, 'knowledge.db'); cfg.ksDataRoot = sandboxRoot; }
          const r = await importLocal(cfg, b.localPath, { branch: b.branch, name: b.name });
          log('ok', `CodeGraph 项目导入（本地直索引）：${b.name || ''} imported=${r.imported}${r.existed ? '（已存在）' : ''} ${r.code_graph_id || ''}`.trim());
          return json(res, 200, { ok: true, ...r });
        }
        if (b.url) {
          const resolved = await resolveCloneUrl(b.url);
          // URL 模式走官方 create（worker clone），本 run 仅实现探测；写路径待沙盒验证
          return json(res, 200, { ok: true, mode: 'probe', probe: resolved, note: 'URL 写路径待沙盒验证（panel create → worker clone → register-meta）' });
        }
        return json(res, 400, { ok: false, reason: 'localPath 或 url 必填' });
      } catch (e) {
        return json(res, 200, { ok: false, reason: String((e && e.message) || e) });
      }
    }

    // ── 阶段1：Wiki 摄入模型（读/写 MemoryKnowledge/.env；t9 A 接通写路径）──
    if (req.method === 'GET' && p === '/api/wiki-model') {
      try {
        const e = readKsEnv();
        return json(res, 200, { ok: true, model: e.model, baseUrl: e.baseUrl, maxTokens: e.maxTokens, keyMasked: e.key ? e.key.slice(0, 4) + '…' : '' });
      } catch (e) {
        return json(res, 200, { ok: false, reason: String((e && e.message) || e) });
      }
    }
    if (req.method === 'POST' && p === '/api/wiki-model') {
      // t9 A：真实写 MemoryKnowledge/.env（备份→原子改写→校验）。生产写需用户授权（面板 confirm 已确认）
      try {
        const body = await readBody(req);
        const r = saveKsEnv(null, body);
        if (!r.ok) return json(res, 200, { ok: false, reason: r.reason });
        log('ok', `Wiki 摄入模型已应用：${body.model || ''} @ ${body.baseUrl || ''}${r.changed?.length ? '（' + r.changed.join('；') + '）' : ''}`);
        return json(res, 200, { ok: true, changed: r.changed, model: body.model || '', baseUrl: body.baseUrl || '' });
      } catch (e) {
        return json(res, 200, { ok: false, reason: String((e && e.message) || e) });
      }
    }

    // ── 唤起方式（tdai-memory-inject config.json 直读/直写，与 dsh 插件热读同一份）──
    if (req.method === 'GET' && p === '/api/evoke') {
      return json(res, 200, { ok: true, config: readEvokeConfig() });
    }
    if (req.method === 'POST' && p === '/api/evoke') {
      const body = await readBody(req);
      const r = saveEvokeConfig(body.patch || {});
      return json(res, r.ok ? 200 : 400, { ok: r.ok, config: r.config, reason: r.reason });
    }
    if (req.method === 'POST' && p === '/api/evoke/test') {
      const body = await readBody(req);
      const r = await testEvoke(body.text || '');
      return json(res, 200, r);
    }

    // ── Harness（统一注入规则 CRUD + 试运行；与插件/唤起测试同源）──
    if (req.method === 'GET' && p === '/api/harness') {
      const cfg = pluginReadConfig();
      return json(res, 200, { ok: true, rules: Array.isArray(cfg.harnessRules) ? cfg.harnessRules : [] });
    }
    if (req.method === 'POST' && p === '/api/harness/save') {
      const body = await readBody(req);
      if (!body || !body.rule) return json(res, 400, { ok: false, reason: '缺少 rule' });
      const cfg = pluginReadConfig();
      const r = harnessSaveRule(cfg, body.rule);
      if (!r.ok) return json(res, 400, { ok: false, reason: r.reason });
      const merged = { ...cfg, harnessRules: r.rules };
      try {
        fs.writeFileSync(TDAI_PLUGIN_CONFIG, JSON.stringify(merged, null, 2), 'utf8');
        log('ok', `Harness 规则已保存 → ${TDAI_PLUGIN_CONFIG}`);
        return json(res, 200, { ok: true, rules: r.rules, rule: r.rule });
      } catch (e) {
        log('warn', `Harness 保存失败: ${String(e)}`);
        return json(res, 500, { ok: false, reason: String(e) });
      }
    }
    if (req.method === 'POST' && p === '/api/harness/delete') {
      const body = await readBody(req);
      if (!body || !body.id) return json(res, 400, { ok: false, reason: '缺少 id' });
      const cfg = pluginReadConfig();
      const rules = (Array.isArray(cfg.harnessRules) ? cfg.harnessRules : []).filter((r) => r && r.id !== body.id);
      const merged = { ...cfg, harnessRules: rules };
      try {
        fs.writeFileSync(TDAI_PLUGIN_CONFIG, JSON.stringify(merged, null, 2), 'utf8');
        log('ok', `Harness 规则已删除: ${body.id}`);
        return json(res, 200, { ok: true, rules });
      } catch (e) {
        return json(res, 500, { ok: false, reason: String(e) });
      }
    }
    if (req.method === 'POST' && p === '/api/harness/test') {
      const body = await readBody(req);
      const text = String(body?.text || '');
      const r = await testUnified(text);
      return json(res, 200, {
        ok: true,
        hit: r.hit,
        harnessHit: r.harnessHit,
        deepHit: r.deepHit,
        harnessHits: r.harnessHits,
        title: r.title,
        text: r.block,
        recallErr: r.recallErr,
      });
    }

    if (req.method === 'GET' && p === '/health') return json(res, 200, { ok: true, port: PORT });
    return json(res, 404, { ok: false, reason: 'not found' });
  } catch (e) {
    json(res, 500, { ok: false, reason: String(e) });
  }
});

async function recoverInterruptedActivation() {
  // 自包含顶层实现（不依赖 handler 内函数；仅处理 journal 中断恢复）
  let j = null;
  try { const raw = fs.readFileSync(MEM0_ACTIVATION, 'utf8'); j = JSON.parse(raw); } catch { j = null; }
  if (!j) return;
  log("info", "检测到中断的激活 journal: " + JSON.stringify(j));
  const sm_port = Number(process.env.MEM0_SEARCH_PORT || 8915);
  const deg_listening = (port) => {
    try {
      const r = spawnSync('lsof', ['-iTCP:'+port,'-sTCP:LISTEN','-n','-P'], { encoding:'utf8' });
      const pids=[]; for (const line of (r.stdout||'').split('\n').slice(1)) { const m=line.trim().match(/^\S+\s+(\d+)/); if (m) pids.push(Number(m[1])); } return pids;
    } catch { return []; }
  };
  const deg_health = async (port) => {
    try {
      const c = new AbortController(); const t = setTimeout(()=>c.abort(),3000);
      const r = await fetch('http://127.0.0.1:'+port+'/health',{signal:c.signal}); clearTimeout(t);
      if(!r.ok) return false; const d = await r.json().catch(()=>null);
      return !!(d && d.ok===true && d.queryReady===true);
    } catch { return false; }
  };
  if (j.committed === true) {
    const ok = await deg_health(sm_port);
    log("info", "activation committed=true health=" + ok);
    if (ok) { fs.rmSync(MEM0_ACTIVATION, { force: true }); try { fs.rmSync(MEM0_IMPORT_LOCK, { force:true }); } catch {} }
    return;
  }
  if (j.movedOld.length === 0 && j.movedCandidate.length === 0) {
    log("info", "激活未触及 active，清理 journal 保留候选");
    fs.rmSync(MEM0_ACTIVATION, { force: true });
    return;
  }
  log("info", "执行中断激活回滚 movedOld=" + JSON.stringify(j.movedOld) + " movedCandidate=" + JSON.stringify(j.movedCandidate));
  const wd = path.join(MEM0_IMPORTS_ROOT, j.runId, 'work');
  const rc = path.join(wd, 'recovery');
  fs.mkdirSync(rc, { recursive: true });
  for (const n of [...j.movedCandidate].reverse()) {
    const src = path.join(MEM0_ROOT, n);
    const dst = path.join(rc, n);
    try {
      if (fs.existsSync(src)) {
        // recovery 是候选回收站：目标已存在（上次残留）先移为 .stale，保证 rename 目标不存在
        if (fs.existsSync(dst)) fs.renameSync(dst, dst + '.stale-' + Date.now());
        fs.renameSync(src, dst);
      }
      // 清理 .stale 残留（防止下一次回滚再撞）
      for (const st of fs.readdirSync(rc)) { if (st.includes('.stale-')) { try { fs.rmSync(path.join(rc, st), { recursive: true, force: true }); } catch {} } }
      log("info", "  candidate<-%s ok", n);
    }
    catch (e) { log("error", "  candidate %s FAIL: " + String(e.message || e), n); }
  }
  for (const n of [...j.movedOld].reverse()) {
    const pv = path.join(MEM0_ROOT, n + '.prev');
    const dst = path.join(MEM0_ROOT, n);
    try {
      if (fs.existsSync(pv)) {
        // 若 active/<n> 仍存在（candidate 转移失败残留），先移走避免 ENOTEMPTY
        if (fs.existsSync(dst)) fs.renameSync(dst, dst + '.reject-' + Date.now());
        fs.renameSync(pv, dst);
      }
      for (const rg of fs.readdirSync(MEM0_ROOT)) { if (rg.includes('.reject-')) { try { fs.rmSync(path.join(MEM0_ROOT, rg), { recursive: true, force: true }); } catch {} } }
      log("info", "  old<-%s ok", n);
    }
    catch (e) { log("error", "  old %s FAIL: " + String(e.message || e), n); }
  }
  if (deg_listening(sm_port).length === 0) {
    try {
      const py = process.env.MEM0_VENV_PY || path.join(MEM0_ROOT, 'venv', 'bin', 'python');
      const srv = process.env.MEM0_SEARCH_SERVER_BOOTSTRAP || process.env.MEM0_SEARCH_SERVER_PY || path.join(MEM0_ROOT, 'mem0-search-server.py');
      const env = { ...process.env, MEM0_SANDBOX_ROOT: MEM0_ROOT, MEM0_SANDBOX_CHROMA: path.join(MEM0_ROOT, 'chroma-data'), MEM0_PROBE_RECORDS: path.join(MEM0_ROOT, 'probe-records.jsonl') };
      const ch = spawn(py, [srv, '--port', String(sm_port)], { env, stdio: 'ignore', detached: true });
      ch.unref(); ch.on('error', () => {});
      try { const cur = JSON.parse(fs.readFileSync(MEM0_OWNER_FILE, 'utf8')); if (cur) { cur.pid = ch.pid; fs.writeFileSync(MEM0_OWNER_FILE, JSON.stringify(cur)); } } catch {}
    } catch (e) { log("error", "spawn 恢复失败: " + String(e && e.message || e)); }
  }
  const ok = await deg_health(sm_port);
  log("info", "回滚后 18915 health=" + ok);
  if (ok) { fs.rmSync(MEM0_ACTIVATION, { force: true }); try { fs.rmSync(MEM0_IMPORT_LOCK, { force:true }); } catch {} }
  else { log("error", "回滚后 health 失败，保留 journal+lock（manual-intervention）"); }
}

const isMain = process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href;
if (isMain) {
  // 孤儿 runner 检测（生产语义：8126 重启后 state.running=true 但无 runner → interrupted）
  // fixes F11: 若 runner 已留下终态 run.json（孤儿跑完但父进程 exit 回调丢失）→ 回填 active + 释放锁，不标 interrupted
  try {
    const st = readMem0State();
    if (st.running) {
      let found = false;
      try {
        const r = spawnSync('pgrep', ['-f', MEM0_PROD_RUN], { encoding: 'utf8' });
        found = r.status === 0 && /^\d+$/m.test((r.stdout || '').trim());
      } catch { found = false; }
      if (!found) {
        let reconciled = false;
        const lock = readImportLock();
        if (lock && lock.workDir) {
          try {
            const rj = JSON.parse(fs.readFileSync(path.join(lock.workDir, 'run.json'), 'utf8'));
            if (rj && ['completed', 'partial-completed', 'failed', 'paused', 'stopped'].includes(rj.outcome)) {
              const s = readMem0State();
              try {
                const cand = JSON.parse(fs.readFileSync(path.join(lock.workDir, 'mem0-state.json'), 'utf8'));
                if (cand && typeof cand.done === 'number') {
                  s.done = cand.done; s.total = cand.total;
                  if (typeof cand.failed === 'number') s.failed = cand.failed;
                  if (cand.cursorTs) s.cursorTs = cand.cursorTs;
                  if (cand.plannedEndTs) s.plannedEndTs = cand.plannedEndTs;
                  if (cand.currentId !== undefined) s.currentId = cand.currentId;
                  if (cand.failedIds) s.failedIds = cand.failedIds;
                  if (cand.lastOutcome) s.lastOutcome = cand.lastOutcome;
                  if (cand.runId) s.runId = cand.runId;
                }
              } catch {}
              s.running = false; s.paused = false; s.interrupted = false; s.lastError = '';
              s.finishedAt = Date.now(); s.lastCode = (rj.lastCode !== undefined ? rj.lastCode : s.lastCode);
              writeMem0State(s);
              releaseImportLock();
              if (['completed', 'partial-completed'].includes(rj.outcome) && !readActivation() && !s.stoppedByUser && !s.paused) {
                globalThis.__mem0PendingActivateRunId = lock.runId;
              }
              reconciled = true;
              log('info', `孤儿 runner 回填（runId=${lock.runId} outcome=${rj.outcome}）: done=${s.done}/${s.total} failed=${s.failed} 游标=${s.cursorTs}，锁已释放`);
            }
          } catch (e) { log('warn', '孤儿 runner 回填尝试失败: ' + String(e && e.message || e)); }
        }
        if (!reconciled) {
          const s = readMem0State();
          s.running = false; s.paused = false; s.interrupted = true;
          s.lastError = '已中断（未跑完）：检测到上次写入进程已不存在（服务重启或进程被终止）';
          writeMem0State(s);
          log('warn', '孤儿 runner 检测：state.running=true 但无 runner 进程 → 标记 interrupted');
        }
      }
    }
  } catch (e) { log('warn', '孤儿 runner 检测失败: ' + String(e && e.message || e)); }
  // 启动恢复（处理中断的激活 journal）
  recoverInterruptedActivation().then(() => {
    server.listen(PORT, HOST, () => {
      log("info", `dsh-console 已启动 http://${HOST}:${PORT}`);
      applyScheduler();
      applyMem0Scheduler();
      migrateLegacyWikiPresets();
      wikiRunner.recoverOrphanedState();
      wikiQueue.recoverQueue();
      wikiQueue.recoverFirstUpdates();
      applyWikiScheduler();
    });
  }).catch((e) => { log("error", "启动恢复失败: " + String(e && e.message || e)); server.listen(PORT, HOST, () => { log("info", `dsh-console 已启动(带恢复失败) http://${HOST}:${PORT}`); applyScheduler(); applyMem0Scheduler(); migrateLegacyWikiPresets(); wikiRunner.recoverOrphanedState(); wikiQueue.recoverQueue(); wikiQueue.recoverFirstUpdates(); applyWikiScheduler(); }); });
}

process.on('SIGTERM', () => { stopScheduler(); stopMem0Scheduler(); process.exit(0); });
process.on('SIGINT', () => { stopScheduler(); stopMem0Scheduler(); process.exit(0); });

// ══════════════════ 唤起方式（tdai-memory-inject） ══════════════════
// 唤起配置单一真源 = 仓库 plugins/tdai-memory-inject/config.json（控制台可写、插件经 symlink 同读一份）
const TDAI_PLUGIN_CONFIG = path.join(BASE, 'plugins', 'tdai-memory-inject', 'config.json');
// legacy 回退：dsh profile 旧路径（symlink 迁移前的实体文件位置）
const TDAI_PLUGIN_CONFIG_LEGACY = path.join(HOME, '.dsh', 'profiles', 'web', 'node_modules', 'tdai-memory-inject', 'config.json');

const EVOKE_DEFAULTS = {
  enabled: true,
  modes: { A: true, B: true, C: false },
  signalWords: ['记忆', '回忆', '之前', '以前', '当时', '上次', '项目进展', '进展如何', '结论', '决策', '怎么做的', '为什么', '记录', '查一下', '回顾', '想想', '历史'],
  commandWords: ['查记忆', '回忆一下', '查一下记录', '翻一下之前的', '记忆里怎么说的', '搜一下记忆'],
  thresholdB: 0.55,
  deepTopK: 6,
  lightTopK: 2,
  budgetChars: 1500,
  l0Mode: 'summary',
  l0SummaryChars: 400,
  dedup: true,
  // ── 阶段5：记忆筛选配置 ──
  qualityCoef: 0.85,      // 板块一 质量线系数
  qualityFloor: 0.48,     // 板块一 质量线兜底
  strongCoef: 0.93,       // 板块一 强相关线系数
  strongFloor: 0.52,      // 板块一 强相关线兜底
  topK: 10,               // 候选池
  l0Coef: 0.93,           // 板块二 L0 相关性系数（独立参数）
  l0Floor: 0.52,          // 板块二 L0 相关性兜底
  l0MinHits: 2,           // 板块二 L0 最低命中词数（原文多处命中即相关，长度无关）
  cmdText: '请执行下面命令，参数已预填：\n[语义检索] mem0 · query="<你的问题>"\n[记忆检索] /v3/atomic/search · query="<你的问题>"\n[原文检索] /v3/conversation/search · query="<你的问题>"',  // 板块三 查询命令文案
  // ── 阶段5：记忆分配参数 ──
  p1Base: 900,            // 板块一基线
  p1Max: 1300,            // 板块一弹性上限
  p2Max: 400,             // 板块二上限（L0）

  endpoint: 'http://127.0.0.1:8420',
  serviceId: 'default',
  apiKey: '',
  teamId: '',
  userId: '',
  agentId: '',
  timeoutMs: 5000,
};

function readEvokeConfig() {
  const candidates = [TDAI_PLUGIN_CONFIG, TDAI_PLUGIN_CONFIG_LEGACY];
  for (const p of candidates) {
    try {
      const raw = JSON.parse(fs.readFileSync(p, 'utf8'));
      return { ...EVOKE_DEFAULTS, ...raw, modes: { ...EVOKE_DEFAULTS.modes, ...(raw.modes || {}) } };
    } catch { /* 尝试下一个 */ }
  }
  return { ...EVOKE_DEFAULTS };
}

function mergeEvokePatch(current, patch) {
  const merged = { ...current };
  for (const [k, v] of Object.entries(patch || {})) {
    if (v === null || v === undefined) continue;
    if (k === 'modes') merged.modes = { ...merged.modes, ...v };
    else merged[k] = v;
  }
  return merged;
}

function saveEvokeConfig(patch, filePath = TDAI_PLUGIN_CONFIG) {
  // 以磁盘现有内容为基准（单一真源，不做 EVOKE_DEFAULTS 注入，避免默认值污染文件）；
  // 文件不存在（首次写入）时以默认值打底。写失败如实返回 {ok:false, reason}，不再静默假成功。
  let current;
  try { current = JSON.parse(fs.readFileSync(filePath, 'utf8')); }
  catch { current = { ...EVOKE_DEFAULTS }; }
  const merged = mergeEvokePatch(current, patch);
  try {
    fs.writeFileSync(filePath, JSON.stringify(merged, null, 2), 'utf8');
    log('ok', `唤起配置已保存 → ${filePath}`);
    return { ok: true, config: merged };
  } catch (e) {
    log('warn', `唤起配置写入失败: ${String(e)}`);
    return { ok: false, config: merged, reason: String(e) };
  }
}

// 阶段5 唤起测试：不再维护 server.js 副本，直接调用 tdai-memory-inject 插件同源链路
// 唯一实现 = 插件 buildRecall（判定→检索 Mem0/L1/L0→准入→renderBlock）。
async function testEvoke(text) {
  return testUnified(String(text || ''));
}

// 统一试运行：Harness 匹配 + DeepSearch 召回（buildRecall）同源，按冻结协议组装统一胶囊
async function testUnified(text) {
  const cfg = pluginReadConfig();
  const rules = (Array.isArray(cfg.harnessRules) ? cfg.harnessRules : []).filter((r) => r && r.enabled !== false);
  const hHits = harnessMatch(rules, text);
  // DeepSearch：仅按原唤起规则命中才检索（Harness 命中不改变唤起判定）
  let recall = null;
  let recallErr = null;
  try {
    recall = await pluginBuildRecall(cfg, text);
  } catch (e) {
    recallErr = String((e && e.message) || e);
  }
  const deepHit = !!recall && !!recall.block && recall.block.trim().length > 0;
  const items = recall ? [
    ...recall.p1.map((it) => ({ id: it.id, kind: it.kind || 'L1', type: it.type, score: it.score, hitCount: it.hitCount, overlapRatio: it.overlapRatio, content: String(it.content || '') })),
    ...recall.l0.map((it) => ({ id: it.id, kind: 'L0', role: it.role, score: it.score, content: String(it.content || it.message_text || '') })),
  ] : [];
  // DeepSearch 原胶囊内部内容：剥掉旧标签外壳，保留板块文本
  let deepText = '';
  if (deepHit) {
    deepText = String(recall.block).replace(/^[\s\S]*?<tdai_memory_recall[^>]*>/, '').replace(/<\/tdai_memory_recall>[\s\S]*$/, '').trim();
  }
  const preview = harnessAssemble(rules, hHits, deepText);
  return {
    ok: true,
    hit: hHits.length > 0 || deepHit,
    harnessHit: hHits.length > 0,
    deepHit,
    mode: recall ? recall.mode : null,
    signal: recall ? recall.signal : null,
    command: recall ? recall.command : null,
    query: recall ? recall.query : null,
    recallErr,
    items,
    l1: recall ? recall.l1 : [],
    mem0: recall ? recall.mem0 : [],
    l0: recall ? recall.l0 : [],
    block: preview.text,
    title: preview.title,
    harnessHits: hHits,
  };
}

export { parseLogLine, loadLogHistory, mergeEvokePatch, saveEvokeConfig, applyYamlEdit, rewriteModelYaml, saveModelPresets, saveEmbeddingPresets, describeModelChange, collectTimeoutInfo, validateModelBody };
