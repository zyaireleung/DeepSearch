        // fixes F7a: 同 write 路由——重置候选 state 为本次起点（retry 复用 workDir，候选残留上次 done）
        try { const cs = { ...ss, running: false, paused: false, startedAt: Date.now(), total: failedN, done: 0, currentId: '', lastError: '' }; delete cs.stoppedByUser; fs.writeFileSync(path.join(workDir, 'mem0-state.json'), JSON.stringify(cs)); } catch {}
        return json(res, 200, { ok: true, started: true, mode: 'failed-only', failedN });
