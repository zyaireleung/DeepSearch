#!/usr/bin/env node
/**
 * dsh-console — TencentDB 控制台（后端）
 *
 * 零第三方依赖（仅 Node 内置模块）。负责：
 *   1. 手动导入 / 全量重导（调 agents/asset-import.ts --source dsh）
 *   2. 调度器：自动读取（fs.watch 监听 sessions 目录） / 循环定时（setInterval）
 *   3. 解析模型切换（改写 MemoryCore/tdai-gateway.local.yaml 并重启 core）
 *   4. 状态 / 配置 / 日志 REST API
 *
 * 启动：node dsh-console/server.js  （默认 127.0.0.1:8126）
 */
import http from 'node:http';
import { execFile, spawn, spawnSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
