import * as wikiQueue from './lib/wiki-queue.js';
// LLM WIKI：统一 LLM 模型预设总表 + 资产快照 resolve。
import * as llmPresets from './lib/llm-presets.js';
// 阶段5：唤起测试/真实注入同源唯一实现 = 沙盒插件模块（apply 的 pre-step 与 console 唤起测试共用 buildRecall）
import { buildRecall as pluginBuildRecall, readConfig as pluginReadConfig, harnessMatch, harnessAssemble, harnessSaveRule, harnessLastUserText, harnessNorm } from './node_modules/tdai-memory-inject/lib/index.js';
import { mountSearchRoutes, initSearchApi } from './search-api.js';
// OV 导入 / 逐步 commit 控制（DeepSearch 新增板块）
import { OvImport } from './lib/ov-import.js';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const CONSOLE_DIR = __dirname;
// LLM WIKI 资产模版（内嵌骨架源，assetize.py 的 SELF）；env WIKI_ASSET_SELF 可覆盖
const ASSET_SELF = process.env.WIKI_ASSET_SELF || path.join(__dirname, 'llm-wiki-asset');
const REPO_ROOT = path.resolve(CONSOLE_DIR, '..');
// better-sqlite3 等原生模块从 MemoryKnowledge 依赖解析（沙盒下经 .sandbox-run/MemoryKnowledge/package.json 锚点）
const _req2 = createRequire(path.join(REPO_ROOT, 'MemoryKnowledge', 'package.json'));
const require2 = (m) => _req2(m);
const HOME = process.env.HOME || '';
const BASE = process.env.TDAI_BASE || REPO_ROOT;
const NODE22 = process.env.TDAI_NODE22 || path.join(HOME, '.local', 'node22', 'bin', 'node');
const PORT = Number(process.env.DEEPSEARCH_CONSOLE_PORT || 6601);
const HOST = process.env.DEEPSEARCH_CONSOLE_HOST || '127.0.0.1';

const ASSET_IMPORT = path.join(BASE, 'agents', 'asset-import.ts');
// tsx CLI 绝对路径（仓库根无 node_modules，不能用 `node --import tsx` 从根解析）
const TSX_CLI = (() => {
  const cand = [
    path.join(BASE, 'MemoryProxy', 'node_modules', 'tsx', 'dist', 'cli.mjs'),
    path.join(BASE, 'MemoryProxy', 'node_modules', '.bin', 'tsx'),
  ];
  for (const c of cand) if (fs.existsSync(c)) return c;
  return 'tsx';
})();
const GATEWAY_YAML = path.join(BASE, 'MemoryCore', 'tdai-gateway.local.yaml');
const GATEWAY_YAML_BAK = GATEWAY_YAML + '.bak-console';
const DEFAULT_SESSIONS = path.join(HOME, '.dsh', 'sessions');
const CONFIG_PATH = path.join(CONSOLE_DIR, 'console-config.json');
// ── OpenViking VLM 配置（直接读写 ~/.openviking/ov.conf 的 vlm 段）──
const OV_CONFIG_PATH = process.env.OV_CONFIG_PATH || path.join(HOME, '.openviking', 'ov.conf');
const DEFAULT_OV_VLM = {
  provider: 'openai',
  api_key: '<API_KEY>',
  model: 'Qwen3.8-27B-4bit',
  api_base: 'http://127.0.0.1:18088/v1',
  temperature: 0.0,
  thinking: null,
  max_tokens: null,
  timeout: 1200,
  max_retries: 3,
  max_concurrent: 32,
  reasoning_effort: null,
};
function readOvConf() {
  try { return JSON.parse(fs.readFileSync(OV_CONFIG_PATH, 'utf8')); }
  catch { return {}; }
}
function readOvVlm() {
  const conf = readOvConf();
  return { ...DEFAULT_OV_VLM, ...(conf.vlm || {}) };
}
function writeOvVlm(vlm) {
  const conf = readOvConf();
  conf.vlm = { ...(conf.vlm || {}), ...vlm };
  const bak = OV_CONFIG_PATH + '.bak-console';
  try { fs.copyFileSync(OV_CONFIG_PATH, bak); } catch {}
  fs.writeFileSync(OV_CONFIG_PATH, JSON.stringify(conf, null, 2) + '\n', 'utf8');
  return conf.vlm;
}
function validateOvVlmBody(body) {
  const errors = [];
  if (body.temperature !== undefined) {
    const t = Number(body.temperature);
    if (!Number.isFinite(t) || t < 0 || t > 2) errors.push('temperature 须在 0–2 之间');
  }
  if (body.timeout !== undefined) {
    const t = Number(body.timeout);
    if (!Number.isFinite(t) || t <= 0) errors.push('timeout 须为正数');
  }
  if (body.max_retries !== undefined) {
    const t = Number(body.max_retries);
    if (!Number.isFinite(t) || t < 0 || t % 1 !== 0) errors.push('max_retries 须为非负整数');
  }
  if (body.max_tokens !== undefined && body.max_tokens !== null) {
    const t = Number(body.max_tokens);
    if (!Number.isFinite(t) || t <= 0 || t % 1 !== 0) errors.push('max_tokens 须为正整数');
  }
  if (body.max_concurrent !== undefined) {
    const t = Number(body.max_concurrent);
    if (!Number.isFinite(t) || t <= 0 || t % 1 !== 0) errors.push('max_concurrent 须为正整数');
  }
  if (body.thinking !== undefined && typeof body.thinking !== 'boolean' && body.thinking !== null) errors.push('thinking 须为 boolean 或 null');
  return errors.length ? { ok: false, reason: errors.join('; ') } : { ok: true };
}
// ── OV 导入 / 逐步 commit（DeepSearch 新增：独立状态与进度文件）──
const OV_STATE = path.join(CONSOLE_DIR, 'ov-state.json');
const OV_PROGRESS = path.join(CONSOLE_DIR, 'ov-progress.json');
const OV_DONE = path.join(CONSOLE_DIR, 'ov-done.json');
const OV_DONE_PARTS = path.join(CONSOLE_DIR, 'ov-done-parts.json');
let _ovImport = null;
function getOvImport() {
  if (!_ovImport) {
    const oc = loadConfig().ovImport || {};
    _ovImport = new OvImport({
      stateFile: OV_STATE, progressFile: OV_PROGRESS, doneFile: OV_DONE, donePartsFile: OV_DONE_PARTS, configFile: CONFIG_PATH,
      ovBaseUrl: oc.ovBaseUrl || 'http://127.0.0.1:1933',
      ovApiKey: oc.ovApiKey || '',
      sessionsDir: oc.sessionsDir || '',
      stateDbPath: oc.stateDbPath || path.join(process.env.HOME || '', 'ToDo', '.sandbox-run', 'dsh-session-import-20261024', 'ingest-script', 'ov-ingest-state-prod.db'),
      log: (...a) => log('info', '[ov-import]', ...a),
    });
  }
  return _ovImport;
}
const LOG_PATH = path.join(BASE, '.tdai-logs', 'console.log');
const STATE_FILE = path.join(BASE, '.asset-import-state.json');
const CORE_ENTRY = path.join(BASE, 'MemoryCore', 'src', 'gateway', 'server.ts');
// ── Mem0 解析导入（L0 → mem0，infer=True；独立游标 mem0-tsCursor，错峰排 L1 之后）──
const MEM0_ROOT = process.env.MEM0_ROOT || path.join(BASE, '.data', 'mem0'); // fixes: 沙盒可用 env 指向 active；生产不设=原路径
const MEM0_STATE = path.join(MEM0_ROOT, 'mem0-state.json');
const MEM0_CONTROL = path.join(MEM0_ROOT, 'mem0-control.json');
const MEM0_PROD_RUN = path.join(MEM0_ROOT, 'mem0-prod-run.py');
const MEM0_SEARCH_PY = path.join(MEM0_ROOT, 'mem0-search.py'); // fallback 一次性脚本（--query CLI，不许改指）
const MEM0_IMPORTS_ROOT = process.env.MEM0_IMPORTS_ROOT || path.join(MEM0_ROOT, 'imports');
const MEM0_IMPORT_LOCK = process.env.MEM0_IMPORT_LOCK || path.join(MEM0_ROOT, 'import.lock');
const MEM0_ACTIVATION = process.env.MEM0_ACTIVATION_FILE || path.join(MEM0_ROOT, 'activation.json');
const MEM0_PREFLIGHT_PORT = Number(process.env.MEM0_PREFLIGHT_PORT || 18916);
const MEM0_SERVER = process.env.MEM0_SERVER_URL || 'http://127.0.0.1:8915';
const MEM0_OWNER_FILE = process.env.MEM0_OWNER_FILE || path.join(MEM0_ROOT, 'mem0-search-owner.json');
// ── fixes F5: 恢复状态必须模块顶层（handler 内每次请求重置会使冷却失效）──
let mem0RecoveryPromise = null;
let lastMem0RecoveryAt = 0;
const MEM0_RECOVERY_COOLDOWN_MS = 30_000;
const MEM0_RECOVERY_MAX_MS = 10_000;
const MEM0_ACTIVATING = { ok: false, source: 'activating', reason: '切换中，勿 fallback' };
const MEM0_RECOVERING = { ok: false, source: 'recovering', retryAfterMs: 3000, reason: '恢复中' };
const BUNDLE_FILES = ['chroma-data', 'mem0-history.db', 'mem0-state.json',
                      'mem0-count.json', 'probe-records.jsonl', 'probe-query.json'];
const MEM0_SEARCH_SERVER_PY = path.join(MEM0_ROOT, 'mem0-search-server.py'); // 常驻服务（--port daemon）预检/激活/恢复专用
const MEM0_VENV_PY = process.env.MEM0_VENV_PY || path.join(MEM0_ROOT, 'venv', 'bin', 'python');
const MEM0_PY_DIR = path.join(MEM0_ROOT, 'py-mem0dir');
const MEM0_CHROMA = path.join(MEM0_ROOT, 'chroma-data');
// 生产/沙盒解释器统一入口：显式 MEM0_VENV_PY 或默认 root/venv；不含任何沙盒硬编码路径
const PROD_MEM0_VENV_PY = ''; // 同步生产=空（无 fallback）；沙盒测试用 MEM0_VENV_PY env 显式指定
const mem0Py = () => (fs.existsSync(MEM0_VENV_PY) ? MEM0_VENV_PY : (PROD_MEM0_VENV_PY && fs.existsSync(PROD_MEM0_VENV_PY) ? PROD_MEM0_VENV_PY : MEM0_VENV_PY));

// ────────────────────────────── 配置 ──────────────────────────────
const DEFAULT_CONFIG = {
  scheduler: { enabled: false, mode: 'cron', intervalMin: 60, startMode: 'now', startAt: '', startDaily: '02:00' }, // mode: watch | cron | manual; startMode: now | at | daily
  import: { teamId: '', agentId: '', extract: 'both', sessionsDir: '', workspace: '' },
  model: { baseUrl: 'http://127.0.0.1:18088/v1', apiKey: '<API_KEY>', model: 'Qwen3.8-27B-4bit' },
  // Mem0 解析导入（L0 → mem0，infer=True；独立游标，错峰排 L1 之后）
  mem0Import: { enabled: false, mode: 'sched', intervalMin: 720, startMode: 'at', startAt: '', startDaily: '03:00', schedN: 200, batchChars: 30000 },
  // Mem0 模型（LLM 解析导入；统一预设表 config.model.presets 引用，不独立建库）
  mem0Model: { baseUrl: 'http://127.0.0.1:18088/v1', apiKey: '<API_KEY>', model: 'Qwen3.8-27B-4bit', maxTokens: 20000 },
  // OV 导入 / 逐步 commit（DeepSearch：会话清单读状态库，串行分批 commit）
  ovImport: { ovBaseUrl: 'http://127.0.0.1:1933', ovApiKey: '', stateDbPath: '', batchSessions: 10, intervalMin: 5, enabled: false, mode: 'sched', startMode: 'daily', startAt: '', startDaily: '03:00' },
  // LLM WIKI 全局定时更新（独立于 TDB/mem0；到点对 enabled 资产串行 startUpdate）
  wikiUpdate: { enabled: false, mode: 'sched', intervalMin: 720, startMode: 'at', startAt: '', startDaily: '03:00' },
};

function loadConfig() {
  try { return { ...DEFAULT_CONFIG, ...JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8')) }; }
  catch { return structuredClone(DEFAULT_CONFIG); }
}
function saveConfig(cfg) {
  fs.writeFileSync(CONFIG_PATH, JSON.stringify(cfg, null, 2) + '\n', 'utf8');
}

// ── Mem0 状态（独立游标 / 计划止于 / 进度）+ 记忆总量计数 ──
function readMem0State() {
  try { return JSON.parse(fs.readFileSync(MEM0_STATE, 'utf8')); }
  catch { return { cursorTs: null, plannedEndTs: null, currentId: '', total: 0, done: 0, failed: 0, running: false, startedAt: 0, finishedAt: 0, lastError: '' }; }
}
function writeMem0State(st) {
  try { fs.mkdirSync(path.dirname(MEM0_STATE), { recursive: true }); fs.writeFileSync(MEM0_STATE, JSON.stringify(st, null, 2)); } catch {}
}
// 记忆总量：只读快照文件（mem0-count.json，由导入/重建完成时写入），零 Chroma 打开。
// 绝不在 status 请求路径 spawn Python/Chroma（曾致生产 SIGSEGV 弹窗）。
const MEM0_COUNT_FILE = path.join(MEM0_ROOT, 'mem0-count.json');
function mem0CountSnapshot() {
  try {
    const d = JSON.parse(fs.readFileSync(MEM0_COUNT_FILE, 'utf8'));
    const n = Number(d.count);
    if (Number.isFinite(n) && n >= 0) return { memoryCount: n, memoryCountStatus: 'snapshot', memoryCountAt: d.at || null };
  } catch {}
  return { memoryCount: null, memoryCountStatus: 'index-unverified', memoryCountAt: null };
}

/** 解析「每次条数」：0 / 空 / 缺省 = 0（全部增量：游标后不限制条数）；>0 = 限制条数。
 *  opts.limitN / opts.limitBatches 优先，回退 config.mem0Import.schedN，再回退 0（全部）。 */
function resolveLimitRows(opts, cfg) {
  const raw = (opts && opts.limitN !== undefined && opts.limitN !== null && opts.limitN !== '') ? opts.limitN
    : ((opts && opts.limitBatches !== undefined && opts.limitBatches !== null && opts.limitBatches !== '') ? opts.limitBatches
    : ((cfg && cfg.schedN !== undefined && cfg.schedN !== null && cfg.schedN !== '') ? cfg.schedN : 0));
  const n = Number(raw);
  return (Number.isFinite(n) && n > 0) ? Math.floor(n) : 0; // 0 = 全部增量；非法/非正数视为全部
}

/** 当前 Mem0 runner 子进程（stop 精确 kill 用；避免 pkill -f 按名误杀） */
let mem0Child = null;

/** 触发一次 Mem0 写入（定时调度入口；写候选 work 目录，绝不直写 active）。
 *  opts.limitN / opts.limitBatches 优先，回退 config.mem0Import.schedN；0=全部增量（游标后不限制条数）。
 *  opts.untilTs / opts.cutoff = 目标截止 ISO（手动导入「目标截止」模式：只处理 recorded_at<=untilTs）。
 *  正在 running 时返回 ok:false + reason，不 spawn 新进程。
 *  保留生产原有的代理环境变量清理（防 :1 端口劫持）。 */
async function runMem0Import(opts = {}) {
  try {
    const untilTs = opts.untilTs || opts.cutoff || ''; // 手动导入「目标截止」模式（recorded_at<=untilTs）
    const limitRows = untilTs ? 0 : resolveLimitRows(opts, config.mem0Import || {}); // 截止模式=全量到截止，不按条数截断
    try { fs.unlinkSync(MEM0_CONTROL); } catch {}
    const r = await startCandidateImport({ source: 'sched', untilTs, limitRows });
    if (!r.ok) return r;
    return { ok: true, started: true, limitRows, runId: r.runId };
  } catch (e) {
    return { ok: false, reason: String(e?.message || e) };
  }
}

let config = loadConfig();

// ── fixes F5 双锁与激活/owner 读写（候选隔离基础设施；merge 时必须保留）──
function acquireImportLock(runId, workDir, mode) {
  const lock = { runId, workDir, mode, childPid: null };
  const fd = fs.openSync(MEM0_IMPORT_LOCK, 'wx');
  fs.writeFileSync(fd, JSON.stringify(lock));
  fs.closeSync(fd);
  return lock;
}
function readImportLock() { try { return JSON.parse(fs.readFileSync(MEM0_IMPORT_LOCK, 'utf8')); } catch { return null; } }
function releaseImportLock() { try { fs.rmSync(MEM0_IMPORT_LOCK, { force: true }); } catch {} }
function readActivation() { try { return JSON.parse(fs.readFileSync(MEM0_ACTIVATION, 'utf8')); } catch { return null; } }
function writeActivation(a) {
  const tmp = MEM0_ACTIVATION + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(a)); fs.fsyncSync(fs.openSync(tmp, 'r+'));
  fs.renameSync(tmp, MEM0_ACTIVATION);
}
function writeResult(workDir, data) {
  const p2 = path.join(workDir, 'run.json'); const tmp = p2 + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(data));
  fs.fsyncSync(fs.openSync(tmp, 'r+'));
  fs.renameSync(tmp, p2);
}
function candidateOutcome(workDir) {
  try { return JSON.parse(fs.readFileSync(path.join(workDir, 'run.json'), 'utf8')); } catch { return null; }
}
function readOwner() { try { return JSON.parse(fs.readFileSync(MEM0_OWNER_FILE, 'utf8')); } catch { return null; } }
function writeOwner(o) { try { fs.writeFileSync(MEM0_OWNER_FILE, JSON.stringify(o)); } catch {} }

/** 候选隔离导入公共入口（write 路由 + 定时调度共用；绝不让 runner 落入直写 active）。
 *  创建 imports/<runId>/work 候选目录 → COW 克隆 active 可变文件 → 运行锁互斥
 *  → spawn runner（MEM0_WORK_DIR 指向候选）→ exit 后按 run.json outcome 释放锁。
 *  source 区分入口：write=手动 / sched=定时 / resume=续跑 / retry=失败清单。 */
async function startCandidateImport({ runIdHint, untilTs = '', limitRows, source = 'write', failedOnly = false } = {}) {
  if (readActivation()) return { ok: false, reason: '激活进行中，拒绝新导入' };
  if (readImportLock()) return { ok: false, reason: '已有导入运行中' };
  const runId = runIdHint || ('run-' + Date.now().toString(36));
  const workDir = path.join(MEM0_IMPORTS_ROOT, runId, 'work');
  fs.mkdirSync(path.join(MEM0_IMPORTS_ROOT, runId), { recursive: true });
  fs.mkdirSync(workDir, { recursive: true });
  // 克隆 active 可变文件 → 候选（COW）
  for (const n of BUNDLE_FILES) {
    const src = path.join(MEM0_ROOT, n);
    if (fs.existsSync(src)) {
      const dst = path.join(workDir, n);
      if (fs.statSync(src).isDirectory()) { try { fs.cpSync(src, dst, { recursive: true, force: true }); } catch { fs.mkdirSync(dst, { recursive: true }); } }
      else { try { fs.copyFileSync(src, dst); } catch {} }
    }
  }
  const lock = acquireImportLock(runId, workDir, source);
  const st = readMem0State(); delete st.stoppedByUser;
  const totalRows = failedOnly ? (st.failedIds || []).length : limitRows;
  writeMem0State({ ...st, running: true, startedAt: Date.now(), total: totalRows, done: 0, currentId: '', lastError: '', runId });
  // fixes F7a: 候选 clone 自带上一轮 done/total（BUNDLE_FILES 复制 active state），status 运行时读候选
  // 会显示上一轮进度（如 200/200）。重置候选 state 为本次起点（保留 cursorTs/plannedEndTs/failedIds 供续跑）。
  try {
    const cand = { ...st, running: false, paused: false, startedAt: Date.now(), total: totalRows, done: 0, currentId: '', lastError: '', runId };
    delete cand.stoppedByUser;
    if (failedOnly) cand.failedIds = st.failedIds || [];
    fs.writeFileSync(path.join(workDir, 'mem0-state.json'), JSON.stringify(cand));
  } catch {}
  const spawnEnv = { ...process.env, MEM0_DIR: MEM0_PY_DIR, MEM0_WORK_DIR: workDir, MEM0_RUN_ID: runId };
  ['http_proxy', 'https_proxy', 'HTTP_PROXY', 'HTTPS_PROXY', 'NO_PROXY', 'no_proxy'].forEach((k) => delete spawnEnv[k]);
  let args;
  if (failedOnly) { args = [MEM0_PROD_RUN, '--run-id', runId, '--failed-only']; }
  else { args = [MEM0_PROD_RUN, '--run-id', runId, '--limit-rows', String(limitRows)]; if (untilTs) args.push('--until', String(untilTs)); }
  const child = spawn(mem0Py(), args, { env: spawnEnv, stdio: 'ignore' });
  mem0Child = child;
  lock.childPid = child.pid; fs.writeFileSync(MEM0_IMPORT_LOCK, JSON.stringify(lock));
  child.on('exit', (code, signal) => {
    if (mem0Child === child) mem0Child = null;
    const c = candidateOutcome(workDir); const x = readMem0State();
    x.running = false; x.finishedAt = Date.now(); x.lastCode = code;
    x.interrupted = !!((signal && !x.stoppedByUser) || (code !== 0 && !x.lastError && !x.paused));
    // fixes: 候选 state 的 done/total/failed 回填 active（否则 status 读 active 卡 done=0）
    try {
      const cand = JSON.parse(fs.readFileSync(path.join(workDir, 'mem0-state.json'), 'utf8'));
      if (cand && typeof cand.done === 'number') {
        x.done = cand.done; x.total = cand.total;
        if (typeof cand.failed === 'number') x.failed = cand.failed;
        if (cand.failedIds) x.failedIds = cand.failedIds;
        if (cand.cursorTs) x.cursorTs = cand.cursorTs;
        if (cand.plannedEndTs) x.plannedEndTs = cand.plannedEndTs;
        if (cand.runId) x.runId = cand.runId;
      }
    } catch {}
    if (c) { x.lastOutcome = c.outcome; writeMem0State(x); if (['completed','paused','stopped','failed','partial-completed'].includes(c.outcome)) releaseImportLock(); else x.stale = true; } else { releaseImportLock(); }
    writeMem0State(x);
    // fixes: 导入成功后标记"待自动激活"（E+ 定时链漏接的闭环；F11: partial-completed 同享，激活后可用 clone retry 补失败）。
    // exit 回调在顶层、无法引用 handler 内定义的 activateReadyImport，
    // 故只设全局标记，由 status 路由（handler 内）消费并执行激活。
    if (c && ['completed', 'partial-completed'].includes(c.outcome) && !c.skippedEmpty && !readActivation() && !x.stoppedByUser && !x.paused) {
      globalThis.__mem0PendingActivateRunId = runId;
    }
  });
  return { ok: true, started: true, runId, workDir, limitRows };
}

// ────────────────────────────── 日志 ──────────────────────────────
const recentLogs = []; // [{time, kind, text}]
function log(kind, text) {
  const line = { time: new Date().toLocaleTimeString('zh-CN', { hour12: false }), kind, text };
  recentLogs.unshift(line);
  if (recentLogs.length > 300) recentLogs.pop();
  try { fs.appendFileSync(LOG_PATH, `[${line.time}] [${kind}] ${text}\n`, 'utf8'); } catch {}
  console.log(`[${line.time}] [${kind}] ${text}`);
}

// ────────────────────────────── 日志历史（重启不丢） ──────────────────────────────
function parseLogLine(line) {
  const m = /^\[(\d{2}:\d{2}:\d{2})\] \[(\w+)\] (.*)$/.exec(line);
  if (!m) return null;
  return { time: m[1], kind: m[2], text: m[3] };
}
function loadLogHistory(filePath = LOG_PATH, max = 300) {
  try {
    const raw = fs.readFileSync(filePath, "utf8");
    const parsed = raw.split("\n").filter(Boolean).map(parseLogLine).filter(Boolean);
    return parsed.slice(-max).reverse(); // newest-first，与 recentLogs.unshift 语义一致
  } catch { return []; }
}
recentLogs.push(...loadLogHistory());

// ────────────────────────────── 工具 ──────────────────────────────
function isPortUpSync(port) {
  try {
    const r = spawnSync('lsof', ['-iTCP:' + port, '-sTCP:LISTEN', '-n', '-P'], { encoding: 'utf8' });
    return r.status === 0 && /LISTEN/.test(r.stdout);
  } catch { return false; }
}

// 从 state 文件嗅探已用过的 agent id（供 UI 预填）
function sniffIdsFromState() {
  try {
    const st = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));
    const done = Array.isArray(st.done) ? st.done : [];
    const agents = new Set();
    for (const k of done) {
      const m = k.match(/^agt-[\w]+/);
      if (m) agents.add(m[0]);
    }
    return { agents: [...agents] };
  } catch { return { agents: [] }; }
}

// ────────────────────────────── 导入执行 ──────────────────────────────
let importRunning = false;
let lastImport = null; // {at, ok, ms, summary}

async function runImport(o = {}) {
  if (importRunning) return { ok: false, reason: 'busy' };
  const cfg = config.import;
  const agentId = o.agentId ?? cfg.agentId;
  const teamId = o.teamId ?? cfg.teamId;
  if (!agentId || !teamId) {
    lastImport = { at: new Date().toISOString(), ok: false, summary: '缺少 agent-id / team-id，请先在「导入管理」选择目标' };
    log('err', lastImport.summary);
    return { ok: false, reason: lastImport.summary };
  }
  importRunning = true;
  const extract = o.extract ?? cfg.extract;
  const sessionsDir = o.sessionsDir || cfg.sessionsDir || DEFAULT_SESSIONS;

  // asset-import 依赖系统 zstd 命令解压 session.jsonl.zstd；PATH 需含 /opt/homebrew/bin
  const env = {
    ...process.env,
    PATH: ['/opt/homebrew/bin', '/usr/local/bin', process.env.PATH].filter(Boolean).join(':'),
    PANEL_URL: process.env.PANEL_URL || 'http://127.0.0.1:8123',
    TDAI_SERVICE_ID: process.env.TDAI_SERVICE_ID || 'default',
    TDAI_USER_KEY: cfg.userKey || process.env.TDAI_USER_KEY || '',
  };
  const args = ['--source', 'dsh', '-y', '--agent-id', agentId, '--team-id', teamId,
    '--extract', extract];
  // ⚠️ 仅当用户显式指定自定义 sessions 目录时才传 --sessions：
  // asset-import 的 scanSessionsOverride 走 listJsonlRecursive + readFileSync，
  // 不识别 session.jsonl.zstd；不传时走 scanSessions（walkFiles + zstd 解压 + dsh 解析），
  // 才是支持 dsh 格式的正确路径。默认用 $DSH_HOME/sessions。
  if (o.sessionsDir || cfg.sessionsDir) args.push('--sessions', sessionsDir);
  // 指定 session id（逗号分隔）筛选；可与自定义目录共存（--session-ids 独立筛选）
  if (o.sessionIds && String(o.sessionIds).trim()) args.push('--session-ids', String(o.sessionIds).trim());
  if (o.force) args.push('--force');
  if (o.workspace || cfg.workspace) args.push('--workspace', o.workspace || cfg.workspace);
  if (o.stateFile) args.push('--state-file', o.stateFile);

  log('run', `asset-import ${extract}${o.force ? ' (force)' : ''} agent=${agentId} team=${teamId}`);
  const t0 = Date.now();
  try {
    const out = await new Promise((resolve) => {
      execFile(NODE22, [TSX_CLI, ASSET_IMPORT, ...args], { cwd: BASE, env, maxBuffer: 64 * 1024 * 1024, timeout: Number(config.import.importTimeoutMs) || 1800000 },
        (err, stdout, stderr) => resolve({ err, stdout, stderr }));
    });
    const text = (out.stdout || '') + (out.stderr || '');
    const ms = Date.now() - t0;
    const ok = !out.err || out.err.code === 0;
    const summary = text.split('\n').filter((l) => /导入|success|完成|session|skill|✓|✗|error|错误|跳过/i.test(l)).slice(-8).join(' | ') || text.slice(0, 300);
    lastImport = { at: new Date().toISOString(), ok, ms, summary, raw: text.slice(0, 1500) };
    log(ok ? 'ok' : 'err', `asset-import ${ms}ms → ${ok ? '成功' : '失败'} ${summary.slice(0, 200)}`);
    importRunning = false;
    // reason 供前端展示真实失败原因（而非笼统的 400 / Bad Request）
    return { ok, ms, summary, reason: ok ? undefined : (summary || text.slice(0, 300)) };
  } catch (e) {
    lastImport = { at: new Date().toISOString(), ok: false, ms: Date.now() - t0, summary: String(e) };
    log('err', `asset-import 异常: ${e.message}`);
    importRunning = false;
    return { ok: false, reason: String(e) };
  }
}

// 列出可导入的 session（调 asset-import --list-sessions，零写入）。
// dir: 可选自定义目录；sessionIds: 可选逗号分隔筛选。返回 {ok, sessions:[{sessionId,origin,messages,timeRange,firstUser}]}
async function listSessions(dir, sessionIds) {
  const env = {
    ...process.env,
    PATH: ['/opt/homebrew/bin', '/usr/local/bin', process.env.PATH].filter(Boolean).join(':'),
  };
  const args = ['--source', 'dsh', '--list-sessions', '-y'];
  if (dir && String(dir).trim()) args.push('--sessions', String(dir).trim());
  if (sessionIds && String(sessionIds).trim()) args.push('--session-ids', String(sessionIds).trim());
  try {
    const out = await new Promise((resolve) => {
      execFile(NODE22, [TSX_CLI, ASSET_IMPORT, ...args], { cwd: BASE, env, maxBuffer: 64 * 1024 * 1024, timeout: 120000 },
        (err, stdout, stderr) => resolve({ err, stdout, stderr }));
    });
    const text = (out.stdout || '') + (out.stderr || '');
    const line = text.split('\n').map((l) => l.trim()).filter((l) => l.startsWith('{')).pop();
    if (!line) return { ok: false, reason: 'asset-import 未返回 JSON：' + text.slice(0, 300) };
    const j = JSON.parse(line);
    return { ok: true, sessions: (j.sessions || []), raw: text.slice(0, 800) };
  } catch (e) {
    return { ok: false, reason: String(e) };
  }
}

// ────────────────────────────── 调度器 ──────────────────────────────
let watcher = null;
let timer = null;
let watchDebounce = null;
let nextRunAt = null; // 下一次 cron 触发的 epoch ms
let mem0Timer = null; // Mem0 调度器 setTimeout 句柄（独立于 TDB timer）
let mem0NextRunAt = null; // Mem0 下一次触发 epoch ms
let wikiTimer = null; // LLM WIKI 调度器 setTimeout 句柄（独立于 TDB/Mem0）
let wikiNextRunAt = null; // LLM WIKI 下一次触发 epoch ms

function pad2(n) { return String(n).padStart(2, '0'); }

/** 通用计算下一次触发时间。三分支：daily（每日固定时间）/ at（指定时间点+interval）/ now（默认，以调用时刻+interval 或上一 nextRunAt 为起点）。
 *  cfg 需含 intervalMin / startMode / startAt / startDaily；prevNextRun 用于 now 模式连续性（null 走 now+interval）。
 *  TDB 与 mem0 共用同一计算逻辑，避免算法漂移。 */
function computeNextRunGeneric(cfg, prevNextRun) {
  const min = Math.max(1, Number(cfg.intervalMin) || 60);
  const intervalMs = min * 60 * 1000;
  const now = Date.now();
  if (cfg.startMode === 'daily') {
    const m = /^(\d{1,2}):(\d{2})$/.exec(cfg.startDaily || '');
    if (!m) return now + intervalMs;
    let d = new Date();
    d.setHours(Number(m[1]), Number(m[2]), 0, 0);
    if (d.getTime() <= now) d = new Date(d.getTime() + 24 * 3600 * 1000);
    return d.getTime();
  }
  if (cfg.startMode === 'at') {
    const t = cfg.startAt ? new Date(cfg.startAt).getTime() : NaN;
    if (!Number.isNaN(t)) {
      let base = t;
      while (base <= now) base += intervalMs;
      return base;
    }
  }
  // now 模式（默认）：以首次 apply 时刻为起点，之后每 interval 触发
  return (prevNextRun && prevNextRun > now) ? prevNextRun : now + intervalMs;
}

/** TDB 调度器下一次触发时间（保留原签名，供 armCronTimer 调用）。 */
function computeNextRun() { return computeNextRunGeneric(config.scheduler, nextRunAt); }

function armCronTimer(fromTrigger = false) {
  nextRunAt = computeNextRun();
  const delay = Math.max(1000, nextRunAt - Date.now());
  const when = `${new Date(nextRunAt).toLocaleString('zh-CN', { hour12: false })}（${Math.round(delay / 60000)} 分钟后）`;
  log('info', fromTrigger ? `循环定时触发完成，下次导入 ${when}` : `调度器已就绪：下次导入 ${when}`);
  timer = setTimeout(async () => {
    if (config.scheduler.enabled && config.scheduler.mode === 'cron') {
      await runImport({});
      // 触发完重新排下一次（now 模式从此刻起算下一周期）
      if (config.scheduler.enabled && config.scheduler.mode === 'cron') armCronTimer(true);
    }
  }, delay);
}

/** Mem0 调度器：镜像 armCronTimer，但消费 mem0Import 配置、触发 runMem0Import、日志带 "Mem0" 前缀。
 *  独立 setTimeout 链，与 TDB armCronTimer 完全解耦。 */
function armMem0Timer(fromTrigger = false) {
  mem0NextRunAt = computeNextRunGeneric(config.mem0Import, mem0NextRunAt);
  const delay = Math.max(1000, mem0NextRunAt - Date.now());
  const when = `${new Date(mem0NextRunAt).toLocaleString('zh-CN', { hour12: false })}（${Math.round(delay / 60000)} 分钟后）`;
  log('info', fromTrigger ? `Mem0 定时触发完成，下次写入 ${when}` : `Mem0 调度器已就绪：下次写入 ${when}`);
  mem0Timer = setTimeout(async () => {
    if (config.mem0Import.enabled && config.mem0Import.mode === 'sched') {
      const r = await runMem0Import({ limitBatches: config.mem0Import.schedN });
      if (r.ok) log('info', `Mem0 定时触发成功（limitN=${r.limitRows}）`);
      else log('warn', `Mem0 定时触发跳过: ${r.reason}`);
      // 无论 ok 与否都重排——避免"跳过"这一次触发就消失
      if (config.mem0Import.enabled && config.mem0Import.mode === 'sched') armMem0Timer(true);
    }
  }, delay);
}

function applyScheduler() {
  stopScheduler();
  if (!config.scheduler.enabled) { log('info', '调度器关闭'); return; }
  const mode = config.scheduler.mode;
  if (mode === 'watch') {
    const dir = config.import.sessionsDir || DEFAULT_SESSIONS;
    if (!fs.existsSync(dir)) { log('warn', `监听目录不存在: ${dir}`); return; }
    try {
      watcher = fs.watch(dir, { recursive: true }, (ev, fn) => {
        if (!config.scheduler.enabled) return;
        if (!fn || !/session\.jsonl(\.zstd)?$/.test(String(fn))) return;
        if (watchDebounce) clearTimeout(watchDebounce);
        watchDebounce = setTimeout(() => runImport({}), 2000); // debounce 2s
      });
      log('info', `自动读取模式已开启，监听 ${dir}`);
    } catch (e) {
      log('warn', `fs.watch 失败（recursive 可能不可用）: ${e.message}`);
    }
  } else if (mode === 'cron') {
    armCronTimer();
  } else {
    nextRunAt = null;
    log('info', '手动模式（无自动任务）');
  }
}
function stopScheduler() {
  if (watcher) { try { watcher.close(); } catch {} watcher = null; }
  if (timer) { clearTimeout(timer); timer = null; }
  if (watchDebounce) { clearTimeout(watchDebounce); watchDebounce = null; }
  nextRunAt = null;
}

/** Mem0 调度器停止：清理 setTimeout 与 nextRunAt。不碰 TDB 的任何状态。 */
function stopMem0Scheduler() {
  if (mem0Timer) { clearTimeout(mem0Timer); mem0Timer = null; }
  mem0NextRunAt = null;
}

/** Mem0 调度器启动：根据 config.mem0Import 决定 arm 或关闭。
 *  独立于 TDB 调度器，不调用 stopScheduler/applyScheduler。 */
function applyMem0Scheduler() {
  stopMem0Scheduler();
  if (config.mem0Import.enabled && config.mem0Import.mode === 'sched') {
    armMem0Timer();
  } else {
    mem0NextRunAt = null;
    log('info', 'Mem0 调度器关闭');
  }
}

// ────────────────────────────── LLM WIKI 全局定时更新 ──────────────────────────────
// 独立 setTimeout 链（镜像 mem0）；到点只把启用资产依次追加到统一持久化队列。
// 任务的真正串行、错误隔离与重启恢复均由 wiki-queue 负责，不读取资产流程状态判断结束。

/** 到点执行：为全部 enabled 资产追加更新任务；当前人工任务或资产化任务不会被跳过或并发。 */
async function wikiRunScheduled() {
  const enabled = wikiAssets.listAssetsW().filter((a) => a.enabled);
  if (!enabled.length) { log('info', 'Wiki 定时触发：无启用资产，跳过'); return; }
  for (const a of enabled) {
    const r = wikiQueue.enqueue({ type: 'update', id: a.id });
    if (!r.ok) log('warn', `Wiki 定时入队失败 ${a.name}: ${r.reason}`);
    else log('info', `Wiki 定时已入队 ${a.name}（${a.id}），队列位置 ${r.position}`);
  }
}

function armWikiTimer(fromTrigger = false) {
  wikiNextRunAt = computeNextRunGeneric(config.wikiUpdate || {}, wikiNextRunAt);
  const delay = Math.max(1000, wikiNextRunAt - Date.now());
  const when = `${new Date(wikiNextRunAt).toLocaleString('zh-CN', { hour12: false })}（${Math.round(delay / 60000)} 分钟后）`;
  log('info', fromTrigger ? `Wiki 定时触发完成，下次更新 ${when}` : `Wiki 调度器已就绪：下次更新 ${when}`);
  wikiTimer = setTimeout(async () => {
    if (config.wikiUpdate?.enabled && config.wikiUpdate.mode === 'sched') {
      await wikiRunScheduled();
      // 无论是否跑完都重排——跳过/失败不消失
      if (config.wikiUpdate?.enabled && config.wikiUpdate.mode === 'sched') armWikiTimer(true);
    }
  }, delay);
}

/** LLM WIKI 调度器停止：清理 setTimeout 与 nextRunAt。不碰 TDB/Mem0 状态。 */
function stopWikiScheduler() {
  if (wikiTimer) { clearTimeout(wikiTimer); wikiTimer = null; }
  wikiNextRunAt = null;
}

/** LLM WIKI 调度器启动：根据 config.wikiUpdate 决定 arm 或关闭。 */
function applyWikiScheduler() {
  stopWikiScheduler();
  if (config.wikiUpdate?.enabled && config.wikiUpdate.mode === 'sched') {
    armWikiTimer();
  } else {
    wikiNextRunAt = null;
    log('info', 'Wiki 调度器关闭');
  }
}

// ────────────────────────────── 模型切换 ──────────────────────────────
// ── yaml 改写纯函数（llm 2空格 / embedding 4空格；数字裸写、字符串 JSON 引号）──
function applyYamlEdit(yaml, key, value, indent) {
  const pad = ' '.repeat(indent);
  const re = new RegExp(`^(${pad}${key}:\\s*).*$`, 'm');
  const rendered = typeof value === 'number' ? String(value) : JSON.stringify(String(value));
  return yaml.replace(re, `$1${rendered}`);
}
function rewriteModelYaml(yaml, model, embedding, timeoutMs, recallTimeoutMs) {
  let out = yaml;
  if (model?.baseUrl !== undefined) out = applyYamlEdit(out, 'baseUrl', model.baseUrl, 2);
  if (model?.apiKey !== undefined) out = applyYamlEdit(out, 'apiKey', model.apiKey, 2);
  if (model?.model !== undefined) out = applyYamlEdit(out, 'model', model.model, 2);
  if (timeoutMs !== undefined) out = applyYamlEdit(out, 'timeoutMs', timeoutMs, 2);
  if (recallTimeoutMs !== undefined) out = applyYamlEdit(out, 'timeoutMs', recallTimeoutMs, 4);
  if (embedding) {
    if (embedding.provider !== undefined) out = applyYamlEdit(out, 'provider', embedding.provider, 4);
    if (embedding.baseUrl !== undefined) out = applyYamlEdit(out, 'baseUrl', embedding.baseUrl, 4);
    if (embedding.apiKey !== undefined) out = applyYamlEdit(out, 'apiKey', embedding.apiKey, 4);
    if (embedding.model !== undefined) out = applyYamlEdit(out, 'model', embedding.model, 4);
    if (embedding.dimensions !== undefined) out = applyYamlEdit(out, 'dimensions', embedding.dimensions, 4);
  }
  return out;
}

/** 校验 /api/model 请求体：完整 model（model+baseUrl）或仅 embedding（至少一项有效）都放行；
 *  空提交（既无 model 也无有效 embedding）拒绝。用户指出功能缺失——改 embedding 无入口生效，
 *  放宽后允许仅提交 embedding（只改 memory.embedding 段 + 重启 core，不碰 llm）。 */
function validateModelBody(body) {
  const b = body || {};
  if (b.model && b.baseUrl) return { ok: true };
  if (b.embedding && (b.embedding.model || b.embedding.baseUrl || b.embedding.provider || b.embedding.dimensions !== undefined)) return { ok: true };
  return { ok: false, reason: '缺少 model / baseUrl，或有效的 embedding 配置' };
}

/** 生成模型切换操作详情描述（供日志记录；无变化返回空串——不产生噪音日志）。
 *  @param {object} oldCfg 切换前 config.model（含 model/embedding/timeoutMs）
 *  @param {object} model 目标 llm 段（{model,...}）
 *  @param {object} [embedding] 目标 embedding 段
 *  @param {number} [timeoutMs] 目标 llm 超时
 *  @returns {string} 如 `模型切换 Qwen3.8-27B-4bit → Qwen3.8-27B-4bit-v2`（可含 embedding/超时变化段） */
function describeModelChange(oldCfg, model, embedding, timeoutMs) {
  const parts = [];
  const oldModel = oldCfg?.model, newModel = model?.model;
  if (oldModel !== newModel && (oldModel || newModel)) {
    parts.push(`模型 ${oldModel || '(无)'} → ${newModel || '(无)'}`);
  }
  const oldEmb = oldCfg?.embedding?.model, newEmb = embedding?.model;
  if (oldEmb !== newEmb && (oldEmb || newEmb)) {
    parts.push(`embedding ${oldEmb || '(无)'} → ${newEmb || '(无)'}`);
  }
  const oldT = oldCfg?.timeoutMs, newT = timeoutMs;
  if (oldT !== newT && newT !== undefined) {
    parts.push(`超时 ${oldT ?? '(默认)'}ms → ${newT}ms`);
  }
  return parts.join('；');
}

async function applyModel(model, embedding, timeoutMs, recallTimeoutMs) {
  const prevModel = config.model;
  // 1. 备份
  try { fs.copyFileSync(GATEWAY_YAML, GATEWAY_YAML_BAK); } catch {}
  // 2. 改写 llm 段（缩进 2 空格）+ embedding 段（缩进 4 空格）+ llm.timeoutMs + recall.timeoutMs
  try {
    const yaml = fs.readFileSync(GATEWAY_YAML, 'utf8');
    const next = rewriteModelYaml(yaml, model, embedding, timeoutMs, recallTimeoutMs);
    if (next === yaml) return { ok: false, reason: 'yaml 无变化（键未找到？）' };
    fs.writeFileSync(GATEWAY_YAML, next, 'utf8');
  } catch (e) { return { ok: false, reason: `改写 yaml 失败: ${e.message}` }; }
  // 3. 重启 core
  const r = await restartCore();
  if (!r.ok) return { ok: false, reason: `yaml 已改但 core 重启失败: ${r.reason}` };
  // 4. 持久化配置（含 embedding / timeoutMs / recallTimeoutMs；presets 由 saveModelPresets 管理，这里不覆盖）
  config.model = { ...config.model, ...(model || {}), embedding: embedding || config.model.embedding, timeoutMs: timeoutMs ?? config.model.timeoutMs, recallTimeoutMs: recallTimeoutMs ?? config.model.recallTimeoutMs };
  saveConfig(config);
  // 5. 操作详情日志（用户反馈 8126 日志只记"已重启"无操作内容）
  const detail = describeModelChange(prevModel, model, embedding, timeoutMs);
  if (detail) log('ok', `模型切换成功：${detail}`);
  return { ok: true };
}

// ── 预设持久化（存 config.model.presets）──
function readModelPresets() {
  // 统一 LLM 总表从磁盘读（runner 资产化并入/资产 resolve 都会写盘；避免内存 stale）
  return llmPresets.readMaster();
}
/** 一次性迁移：旧 Wiki 摄入预设（config.model.wikiModelPresets）并入统一 LLM 总表（model.presets）。
 *  规则（llm-presets.migrateLegacyPresets）：缺失名整体并入；同名只回填总表缺失字段（总表值不动）；
 *  迁移后清除旧 key 防重复合并。日志留痕改/增/回填明细。 */
function migrateLegacyWikiPresets() {
  try {
    const old = config.model?.wikiModelPresets;
    if (!Array.isArray(old) || !old.length) return;
    const r = llmPresets.migrateLegacyPresets(config, (m) => log('info', m));
    delete config.model.wikiModelPresets;   // migrateLegacyPresets 已删，双保险
    saveConfig(config);
    log('info', `旧 Wiki 摄入预设迁移完成（新增 ${r.added.length} 条，回填 ${Object.keys(r.backfilled).length} 条）`);
  } catch (e) { log('warn', '迁移旧 Wiki 摄入预设失败: ' + String(e && e.message || e)); }
}
function saveModelPresets(list, cfgPath = CONFIG_PATH) {
  const clean = Array.isArray(list) ? list.filter((p) => p && p.name && p.baseUrl && p.model) : [];
  config.model = { ...config.model, presets: clean };
  // 显式 cfgPath（如测试临时目录）只写该路径，绝不碰真实 CONFIG_PATH（含 userKey 密钥）
  if (cfgPath && cfgPath !== CONFIG_PATH) {
    let disk = {};
    try { disk = JSON.parse(fs.readFileSync(cfgPath, 'utf8')); } catch {}
    disk.model = { ...(disk.model || {}), presets: clean };
    fs.writeFileSync(cfgPath, JSON.stringify(disk, null, 2) + '\n', 'utf8');
  } else {
    saveConfig(config);
  }
  return clean;
}

/** Embedding 预设持久化（镜像 model.presets 的增删改：存 config.model.embeddingPresets）。
 *  @param {Array} list 预设数组（过滤缺 name/provider/model 的项）
