// LLM WIKI 板块：资产注册表（独立 JSON 文件，不动 console-config.json）
import * as wikiAssets from './lib/wiki-assets.js';
// LLM WIKI 板块：更新执行器（spawn run_fullflow.py + 锁 + 状态 + SIGSTOP/SIGCONT/kill）
