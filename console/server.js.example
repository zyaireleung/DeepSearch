/** Wiki 摄入模型默认种子预设（存储为空时兜底，不落盘）。
 *  修复 2026-09-20 (t9 B)：wikiModelPresets 空 → 下拉空白，返回内置常用预设。 */
function wikiModelSeedPresets() {
  return [
    { name: '本地 Qwen3.8-27B', model: 'Qwen3.8-27B-4bit', baseUrl: 'http://127.0.0.1:18088/v1', apiKey: '<API_KEY>', maxTokens: 32768 },
    { name: 'sensenova deepseek-v4-flash', model: 'deepseek-v4-flash', baseUrl: 'https://token.sensenova.cn/v1', apiKey: '', maxTokens: 32768 },
  ];
}

/** 写 MemoryKnowledge/.env（Wiki 摄入模型）。修复 2026-09-20 (t9 A)：POST 占位 → 真实实现。
 *  备份 .env → 原子改写 4 键 → 校验。envPath 可注入（沙盒/测试用临时路径，绝不碰生产）。
 *  @returns {{ok:boolean, reason?:string, changed?:string[]}} */
function saveKsEnv(envPath, patch) {
  const p = envPath || path.join(BASE, 'MemoryKnowledge', '.env');
  if (!fs.existsSync(p)) return { ok: false, reason: `.env 不存在: ${p}` };
  const model = (patch.model || '').trim();
  if (!model) return { ok: false, reason: 'model 必填' };
  if (patch.baseUrl && !/^https?:\/\//.test(patch.baseUrl.trim())) return { ok: false, reason: 'baseUrl 需为 http(s):// 开头' };
  const raw = fs.readFileSync(p, 'utf8');
  const lines = raw.split('\n');
  const kv = { LLM_MODEL: model, LLM_BASE_URL: patch.baseUrl, LLM_API_KEY: patch.apiKey, LLM_MAX_TOKENS: patch.maxTokens };
  const changed = [];
  const out = lines.map((line) => {
    const m = line.match(/^([A-Z0-9_]+)=(.*)$/);
    if (!m || !(m[1] in kv) || kv[m[1]] === undefined) return line;
    const v = String(kv[m[1]]);
    if (line !== `${m[1]}=${v}`) changed.push(`${m[1]}: ${line.split('=')[1]} → ${v}`);
    return `${m[1]}=${v}`;
  });
  const missing = Object.keys(kv).filter((k) => kv[k] !== undefined && !out.some((l) => l.startsWith(k + '=')));
  for (const k of missing) { out.push(`${k}=${kv[k]}`); changed.push(`${k}: (新增) → ${kv[k]}`); }
  fs.writeFileSync(p, out.join('\n'), 'utf8');
  return { ok: true, changed };
}

/** Wiki 摄入模型预设种子兜底 + 读写（修复 t9 B：空存储返回种子，不落盘）。 */
function readWikiModelPresets() {
  const stored = config.model?.wikiModelPresets;
  return Array.isArray(stored) && stored.length ? stored : wikiModelSeedPresets();
}

function restartCore() {
  return new Promise((resolve) => {
    try {
      const pid = spawnSync('lsof', ['-tiTCP:8420', '-sTCP:LISTEN', '-n', '-P'], { encoding: 'utf8' }).stdout.trim();
      if (pid) spawnSync('kill', [pid]);
    } catch {}
    // 起新 core（对齐 tdai-local.sh 的 cmd_core：cd MemoryCore && node --import tsx src/gateway/server.ts）
    // MOD-009：必须带 TDAI_GATEWAY_CONFIG 指向 tdai-gateway.local.yaml，否则 core fallback 到
    // 默认 dataDir（~/.memory-tencentdb）因沙箱 EPERM 启动失败 → 8420 30s 未就绪 → 报"core 重启失败"。
    const env = {
      ...process.env,
      PATH: [path.dirname(NODE22), '/opt/homebrew/bin', process.env.PATH].filter(Boolean).join(':'),
      TDAI_GATEWAY_CONFIG: GATEWAY_YAML,
    };
    try {
      const child = spawn(NODE22, ['--import', 'tsx', CORE_ENTRY], {
        cwd: path.join(BASE, 'MemoryCore'), env, detached: true, stdio: 'ignore',
      });
      child.unref();
    } catch (e) { resolve({ ok: false, reason: String(e) }); return; }
    const t0 = Date.now();
    const poll = setInterval(() => {
      if (isPortUpSync(8420)) {
        clearInterval(poll);
        log('ok', `core 已重启（${Date.now() - t0}ms）`);
        resolve({ ok: true });
      } else if (Date.now() - t0 > 30000) {
        clearInterval(poll);
        resolve({ ok: false, reason: 'core 30s 内未就绪' });
      }
    }, 800);
  });
}

// ────────────────────────────── HTTP 服务 ──────────────────────────────
function json(res, code, obj) {
  res.writeHead(code, { 'content-type': 'application/json; charset=utf-8', 'access-control-allow-origin': '*', 'access-control-allow-headers': 'content-type', 'access-control-allow-methods': 'GET,POST,OPTIONS' });
  res.end(JSON.stringify(obj));
}

// ── 阶段1：KS(8421) 只读查询（x-tdai-service-id 头，wiki/cg 同鉴权）──
const KS_URL = process.env.TDAI_KS_URL || 'http://127.0.0.1:8421';
async function ksPost(path, body) {
  const r = await fetch(`${KS_URL}${path}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-tdai-service-id': 'default' },
    body: JSON.stringify(body),
  });
  if (!r.ok) throw new Error(`KS ${path} HTTP ${r.status}`);
  const j = await r.json().catch(() => ({}));
  return (j.data && j.data.items) || j.data || [];
}

// 引用校验：livePages=[{id,title}]（page/ls 实时）；返回 ref 三态
function refState(ref, livePages) {
  if (livePages.some((p) => p.id === ref.id)) return { ref: 'ok', refTo: null };
  const byTitle = livePages.find((p) => p.title === ref.titleAtSave);
  if (byTitle) return { ref: 'drift', refTo: byTitle.id };
  return { ref: 'gone', refTo: null };
}

// pages 视图：page/ls 实时页 + 本地标签合并 + 断链三态
async function wikiMapPages(wikiId) {
  try {
    const live = await ksPost('/v3/wiki/page/ls', { wiki_id: wikiId });
    const local = maps.loadMaps('wiki');
    const pages = live.map((p) => {
      const labels = [];
      for (const [lb, refs] of Object.entries(local.labels)) {
        const r = refs.find((x) => x.wiki_id === wikiId && x.id === p.id);
        if (r) labels.push(lb);
      }
      return { id: p.id, title: p.title, type: p.type || 'other', path: p.path || '', labels };
    });
    // 断链三态：本地引用对应的来源对象（页或已消失页）
    const issues = [];
    for (const [lb, refs] of Object.entries(local.labels)) {
      for (const r of refs) {
        if (r.wiki_id !== wikiId) continue;
        const st = refState(r, live);
        if (st.ref !== 'ok') issues.push({ label: lb, id: r.id, titleAtSave: r.titleAtSave, ...st });
      }
    }
    return { ok: true, wiki_id: wikiId, pages, total: pages.length, issues };
  } catch (e) {
    return { ok: true, wiki_id: wikiId, pages: [], total: 0, issues: [], reason: String((e && e.message) || e) };
  }
}

// validate：全量扫该 wiki 引用 → summary + items
async function wikiMapValidate(wikiId) {
  try {
    const live = await ksPost('/v3/wiki/page/ls', { wiki_id: wikiId });
    const local = maps.loadMaps('wiki');
    const items = [];
    for (const [lb, refs] of Object.entries(local.labels)) {
      for (const r of refs) {
        if (r.wiki_id !== wikiId) continue;
        const st = refState(r, live);
        if (st.ref !== 'ok') items.push({ label: lb, id: r.id, titleAtSave: r.titleAtSave, ...st });
      }
    }
    const summary = { drift: items.filter((i) => i.ref === 'drift').length, gone: items.filter((i) => i.ref === 'gone').length };
    return { ok: true, wiki_id: wikiId, summary, items };
  } catch (e) {
    return { ok: true, wiki_id: wikiId, summary: { drift: 0, gone: 0 }, items: [], reason: String((e && e.message) || e) };
  }
}

/** 断链引用一键修复（t9 D）：drift（titleAtSave 匹配到新 id）→ 重挂映射到新 id；gone 不修。
 *  @returns {{ok:boolean, fixed:number, skipped:number, items:Array}} */
async function wikiMapFix(wikiId) {
  try {
    const live = await ksPost('/v3/wiki/page/ls', { wiki_id: wikiId });
    const local = maps.loadMaps('wiki');
    const fixed = [];
    const skipped = [];
    for (const [lb, refs] of Object.entries(local.labels)) {
      for (const r of refs) {
        if (r.wiki_id !== wikiId) continue;
        const st = refState(r, live);
        if (st.ref === 'ok') continue;
        if (st.ref === 'drift' && st.refTo) {
          // 重挂：新 id 保留 titleAtSave，删除旧引用
          maps.removeLabelRef('wiki', lb, wikiId, r.id);
          maps.addLabelRef('wiki', lb, { wikiId, id: st.refTo, titleAtSave: r.titleAtSave });
          fixed.push({ label: lb, from: r.id, to: st.refTo });
        } else {
          skipped.push({ label: lb, id: r.id, ref: st.ref });
        }
      }
    }
    return { ok: true, wiki_id: wikiId, fixed: fixed.length, skipped: skipped.length, fixedItems: fixed, skippedItems: skipped };
  } catch (e) {
    return { ok: false, reason: String((e && e.message) || e) };
  }
}

/** 定位 cg 的 codegraph 索引 DB（t9b CG-NODES）：dataRoot/<service>/<team>/<cgId>/.codegraph/codegraph.db
 *  dataRoot 可用 SANDBOX_KS_DATA_ROOT env 覆盖（沙盒隔离）。 */
async function findCgIndexDb(cgId) {
  try {
    const roots = [];
    if (process.env.SANDBOX_KS_DATA_ROOT) roots.push(process.env.SANDBOX_KS_DATA_ROOT);
    roots.push(path.join(BASE, 'MemoryKnowledge', 'data'));
    for (const root of roots) {
      const walk = (dir, depth) => {
        if (depth > 3) return null;
        let entries = [];
        try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return null; }
        for (const e of entries) {
          const full = path.join(dir, e.name);
          if (e.isDirectory()) {
            if (e.name === cgId) {
              const db = path.join(full, '.codegraph', 'codegraph.db');
              return fs.existsSync(db) ? db : null;
            }
            const found = walk(full, depth + 1);
            if (found) return found;
          }
        }
        return null;
      };
      const found = walk(root, 0);
      if (found) return found;
    }
    return null;
  } catch { return null; }
}

/** 从 codegraph 索引 DB 读节点（t9b CG-NODES）：nodes 表 id/kind/name/file_path。 */
function queryCgNodes(dbPath) {
  return new Promise((resolve, reject) => {
    try {
      const Database = require2('better-sqlite3');
      const db = new Database(dbPath, { readonly: true });
      const rows = db.prepare('SELECT id, kind, name, file_path FROM nodes ORDER BY kind, name').all();
      db.close();
      resolve(rows);
    } catch (e) { reject(e); }
  });
}

async function listAssets(type) {
  const kind = type === 'codegraph' ? 'codegraph' : 'wiki';
  try {
    const items = await teamAssets(type === 'codegraph' ? 'code-graph' : 'wiki');
    const local = maps.loadMaps(kind);
    const out = items.map((a) => {
      const id = a.knowledge_id || a.wiki_id || a.code_graph_id || a.asset_id || a.id || '';
      return {
        wiki_id: kind === 'wiki' ? id : undefined,
        code_graph_id: kind === 'codegraph' ? id : undefined,
        name: a.name || a.wiki_name || a.repo_name || a.title || id,
        status: a.status || 'ready',
        page_count: a.page_count ?? a.pageCount ?? null,
        managed: !!(local.assets[id] && local.assets[id].managed),
      };
    });
    return { ok: true, items: out, total: out.length };
  } catch (e) {
    return { ok: true, items: [], total: 0, reason: String((e && e.message) || e) };
  }
}

function readBody(req) {
  return new Promise((resolve) => {
    let d = '';
    req.on('data', (c) => { d += c; if (d.length > 2_000_000) req.destroy(); });
    req.on('end', () => { try { resolve(d ? JSON.parse(d) : {}); } catch { resolve({}); } });
  });
}

// LLM WIKI 资产骨架判定：scripts/ + config.yaml + prompts/ + schema/ 齐备（与 assetize.py is_asset 一致）
function isAssetSkeleton(target) {
  try {
    return ['scripts', 'config.yaml', 'prompts', 'schema'].every(name => fs.existsSync(path.join(target, name)));
  } catch { return false; }
}

// 系统文件夹选择器（macOS 原生弹窗）：异步 spawn osascript，前端轮询结果
let wikiPick = null; // {path|null, done, ts}
function pickFolder() {
  wikiPick = null;
  const child = spawn('osascript', ['-e', 'POSIX path of (choose folder)'], { stdio: ['ignore', 'pipe', 'pipe'] });
  let out = '';
  child.stdout.on('data', (c) => { out += c; });
  child.on('exit', (code) => { wikiPick = { path: code === 0 ? out.trim() : null, done: true, ts: Date.now() }; });
  child.on('error', () => { wikiPick = { path: null, done: true, ts: Date.now() }; });
}

function getStatus() {
  return {
    services: {
      core: isPortUpSync(8420), knowledge: isPortUpSync(8421), panel: isPortUpSync(8123),
      proxy: isPortUpSync(8096), console: true,
    },
    scheduler: { ...config.scheduler, nextRunAt },
    importRunning,
    lastImport,
    model: config.model,
    importConfig: config.import,
    sniffed: sniffIdsFromState(),
  };
}

/** 超时配置清单（用户原则 2026-09-08：可配置的单独显示+可改，硬编码的只显示信息不提供修改）。
 *  每项 {key,label,value,unit,editable,source}；embedding 段无 timeoutMs 配置，按用户指示不显示。 */
function collectTimeoutInfo(cfg) {
  const c = cfg || {};
  return [
    { key: 'llm.timeoutMs', label: '解析 LLM 超时', value: c.model?.timeoutMs ?? 720000, unit: 'ms', editable: true, source: 'tdai-gateway.local.yaml llm.timeoutMs（面板可改）' },
    { key: 'memory.recall.timeoutMs', label: '记忆召回超时', value: c.model?.recallTimeoutMs ?? 5000, unit: 'ms', editable: true, source: 'yaml memory.recall.timeoutMs（面板可改，默认 5000）' },
    { key: 'import.importTimeoutMs', label: '控制台导入超时', value: c.import?.importTimeoutMs ?? 1800000, unit: 'ms', editable: true, source: 'console-config.json import.importTimeoutMs（面板可改，默认 30min）' },
    { key: 'l1.extract', label: 'L1 解析超时', value: 720000, unit: 'ms', editable: false, source: '代码硬编码（l1-extractor.ts，不吃 yaml）' },
    { key: 'l1.dedup', label: 'L1 去重超时', value: 720000, unit: 'ms', editable: false, source: '代码硬编码（l1-dedup.ts，不吃 yaml）' },
    { key: 'l3.persona', label: 'L3 persona 超时', value: 720000, unit: 'ms', editable: false, source: '代码硬编码（persona-generator.ts，注释误导写 180s）' },
    { key: 'worker.lockTtlMs', label: 'worker 锁 TTL', value: 600000, unit: 'ms', editable: false, source: '代码硬编码（锁 10min 超时）' },
    { key: 'worker.lockRetry', label: 'worker 锁重试上限', value: '15+40 次 ≈27.5min', unit: '', editable: false, source: '代码硬编码（等锁重试策略）' },
  ];
}

const WEB_DIR = path.join(CONSOLE_DIR, 'web');
function serveStatic(req, res, p) {
  let file = p === '/' ? 'index.html' : p.replace(/^\/+/, '');
  let fp = path.join(WEB_DIR, file);
  if (!fp.startsWith(WEB_DIR)) { json(res, 403, { ok: false }); return; }
  if (!fs.existsSync(fp) || fs.statSync(fp).isDirectory()) { fp = path.join(WEB_DIR, 'index.html'); }
  const ext = path.extname(fp);
  const mime = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.css': 'text/css; charset=utf-8', '.json': 'application/json', '.svg': 'image/svg+xml' }[ext] || 'application/octet-stream';
  res.writeHead(200, { 'content-type': mime });
  fs.createReadStream(fp).pipe(res);
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, `http://${req.headers.host}`);
  const p = url.pathname;
  if (req.method === 'OPTIONS') { res.writeHead(204); res.end(); return; }

  // ── deep_search 总表 API（⑧ 集成：唯一写者 Console 内，OV 通道指沙盒 1934，绝不 1933）──
  if (p === '/search' || p === '/next' || p === '/read' || p === '/status' || p === '/sync' || p.startsWith('/sync/') || p === '/source-catalog' || p === '/source-stats') {
    if (!globalThis.__dsSearchApi) {
      const oc = loadConfig();
      initSearchApi({
        dbPath: path.join(CONSOLE_DIR, '.data', 'deep-search.db'),
        wikiAssetsJsonPath: path.join(CONSOLE_DIR, '.dsh', 'wiki-assets.json'),
        ov: { baseUrl: process.env.DEEP_SEARCH_OV_URL || oc.ovImport?.ovBaseUrl || 'http://127.0.0.1:1933', apiKey: oc.ovImport?.ovApiKey || '' },
        mem0: { baseUrl: process.env.MEM0_SERVER_URL || 'http://127.0.0.1:8915' },
        embed: { baseUrl: 'http://<EMBED_HOST>:8810/v1', apiKey: '<API_KEY>', model: 'WeMM-Embedding-2B-MLX-4bit', dimensions: 1024 },
        config: oc,
      });
      globalThis.__dsSearchApi = true;
    }
    let b = {};
    if (req.method === 'POST' || req.headers['content-length']) { try { b = await readBody(req); } catch {} }
    if (await mountSearchRoutes(req, res, p, b)) return;
  }

  try {
    if (req.method === 'GET' && !p.startsWith('/api/') && !p.startsWith('/health')) return serveStatic(req, res, p);
    if (req.method === 'GET' && p === '/api/status') return json(res, 200, getStatus());
    // ── OV 导入 / 逐步 commit（DeepSearch 新增板块）──
    if (req.method === 'GET' && p === '/api/ov/status') return json(res, 200, getOvImport().status());
    if (req.method === 'GET' && p === '/api/ov/sessions') return json(res, 200, getOvImport().listSessions());
    if (req.method === 'POST' && p === '/api/ov/run') {
      const b = await readBody(req);
      const r = await getOvImport().run(b.importN);
      return json(res, r.ok ? 200 : 400, r);
    }
    if (req.method === 'POST' && p === '/api/ov/pause') return json(res, 200, getOvImport().pause());
    if (req.method === 'POST' && p === '/api/ov/resume') return json(res, 200, getOvImport().resume());
    if (req.method === 'POST' && p === '/api/ov/stop') return json(res, 200, getOvImport().stop());
    if (req.method === 'POST' && p === '/api/ov/reset') return json(res, 200, getOvImport().reset());
    if (req.method === 'POST' && p === '/api/ov/config') {
      const b = await readBody(req);
      const cfg = loadConfig();
      cfg.ovImport = { ...(cfg.ovImport || {}), ...(b || {}) };
      saveConfig(cfg);
      const r = getOvImport().saveConfig(cfg.ovImport);
      return json(res, 200, { ok: true, ...r });
    }
    if (req.method === 'GET' && p === '/api/logs') return json(res, 200, { logs: recentLogs });
    if (req.method === 'GET' && p === '/api/timeouts') return json(res, 200, { ok: true, items: collectTimeoutInfo(config) });

    if (req.method === 'POST' && p === '/api/config') {
      const body = await readBody(req);
      if (body.scheduler) config.scheduler = { ...config.scheduler, ...body.scheduler };
      if (body.import) config.import = { ...config.import, ...body.import };
      if (body.model) config.model = { ...config.model, ...body.model };
      saveConfig(config);
      applyScheduler();
      return json(res, 200, { ok: true, config });
    }

    if (req.method === 'POST' && p === '/api/import') {
      const body = await readBody(req);
      const r = await runImport({ force: !!body.force, extract: body.extract, agentId: body.agentId, teamId: body.teamId, workspace: body.workspace, sessionsDir: body.sessionsDir, sessionIds: body.sessionIds });
      return json(res, r.ok ? 200 : 400, r);
    }

    if (req.method === 'GET' && p === '/api/sessions') {
